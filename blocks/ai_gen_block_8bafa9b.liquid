{% doc %}
  @prompt
    I need a form for customers to fill the personal information,include first name, last name, email address, Instagram account, address, why and  what, need a horizontal version to fit the page size. , The background should be white, and all titles should be centered.
    All question boxes should have the same style.
    Remove the “Why” and “What” question boxes, and add the following two questions.Why are you interested?
    Have you purchased from us ?, Combine First name and Last name into one field called Name.
    Also, make the Address and Why are you interested? fields the same size as the other fields.
    Each question box should only have two lines of space., make the Address and Why are you interested? fields the same size as the other fields.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customer-form-{{ ai_gen_id }} {
    background-color: #ffffff;
    padding: {{ block.settings.form_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.border_color }};
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-customer-form__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-align: center;
  }

  .ai-customer-form__subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0 0 {{ block.settings.form_spacing }}px;
    text-align: center;
  }

  .ai-customer-form__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: {{ block.settings.field_spacing }}px;
    margin-bottom: {{ block.settings.form_spacing }}px;
  }

  .ai-customer-form__field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-customer-form__label-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size }}px;
    margin-bottom: 8px;
    font-weight: 500;
    text-align: center;
  }

  .ai-customer-form__input-{{ ai_gen_id }},
  .ai-customer-form__textarea-{{ ai_gen_id }},
  .ai-customer-form__select-{{ ai_gen_id }} {
    padding: {{ block.settings.input_padding }}px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.input_text_size }}px;
    color: {{ block.settings.input_text_color }};
    background-color: {{ block.settings.input_background_color }};
    transition: border-color 0.3s ease;
    width: 100%;
    box-sizing: border-box;
    height: 48px;
    line-height: 1.4;
  }

  .ai-customer-form__input-{{ ai_gen_id }}:focus,
  .ai-customer-form__textarea-{{ ai_gen_id }}:focus,
  .ai-customer-form__select-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-customer-form__textarea-{{ ai_gen_id }} {
    resize: none;
    overflow-y: hidden;
  }

  .ai-customer-form__button-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.form_spacing }}px;
  }

  .ai-customer-form__button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    min-width: 200px;
  }

  .ai-customer-form__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  .ai-customer-form__success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    text-align: center;
    margin-top: 16px;
    font-size: {{ block.settings.input_text_size }}px;
  }

  .ai-customer-form__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    text-align: center;
    margin-top: 16px;
    font-size: {{ block.settings.input_text_size }}px;
  }

  @media screen and (max-width: 768px) {
    .ai-customer-form__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.field_spacing | times: 0.8 }}px;
    }
    
    .ai-customer-form-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-customer-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% form 'contact' %}
    {% if block.settings.form_title != blank %}
      <h2 class="ai-customer-form__title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h2>
    {% endif %}
    
    {% if block.settings.form_subtitle != blank %}
      <p class="ai-customer-form__subtitle-{{ ai_gen_id }}">{{ block.settings.form_subtitle }}</p>
    {% endif %}

    <div class="ai-customer-form__grid-{{ ai_gen_id }}">
      <div class="ai-customer-form__field-{{ ai_gen_id }}">
        <label class="ai-customer-form__label-{{ ai_gen_id }}" for="name-{{ ai_gen_id }}">
          {{ block.settings.name_label }}
        </label>
        <input
          type="text"
          id="name-{{ ai_gen_id }}"
          name="contact[name]"
          class="ai-customer-form__input-{{ ai_gen_id }}"
          value="{{ form.name }}"
          placeholder="{{ block.settings.name_placeholder }}"
          required
        >
      </div>

      <div class="ai-customer-form__field-{{ ai_gen_id }}">
        <label class="ai-customer-form__label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
          {{ block.settings.email_label }}
        </label>
        <input
          type="email"
          id="email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-customer-form__input-{{ ai_gen_id }}"
          value="{{ form.email }}"
          placeholder="{{ block.settings.email_placeholder }}"
          required
        >
      </div>

      <div class="ai-customer-form__field-{{ ai_gen_id }}">
        <label class="ai-customer-form__label-{{ ai_gen_id }}" for="instagram-{{ ai_gen_id }}">
          {{ block.settings.instagram_label }}
        </label>
        <input
          type="text"
          id="instagram-{{ ai_gen_id }}"
          name="contact[instagram]"
          class="ai-customer-form__input-{{ ai_gen_id }}"
          value="{{ form.instagram }}"
          placeholder="{{ block.settings.instagram_placeholder }}"
        >
      </div>

      <div class="ai-customer-form__field-{{ ai_gen_id }}">
        <label class="ai-customer-form__label-{{ ai_gen_id }}" for="address-{{ ai_gen_id }}">
          {{ block.settings.address_label }}
        </label>
        <input
          type="text"
          id="address-{{ ai_gen_id }}"
          name="contact[address]"
          class="ai-customer-form__input-{{ ai_gen_id }}"
          value="{{ form.address }}"
          placeholder="{{ block.settings.address_placeholder }}"
        >
      </div>

      <div class="ai-customer-form__field-{{ ai_gen_id }}">
        <label class="ai-customer-form__label-{{ ai_gen_id }}" for="interest-{{ ai_gen_id }}">
          {{ block.settings.interest_label }}
        </label>
        <input
          type="text"
          id="interest-{{ ai_gen_id }}"
          name="contact[interest]"
          class="ai-customer-form__input-{{ ai_gen_id }}"
          value="{{ form.interest }}"
          placeholder="{{ block.settings.interest_placeholder }}"
        >
      </div>

      <div class="ai-customer-form__field-{{ ai_gen_id }}">
        <label class="ai-customer-form__label-{{ ai_gen_id }}" for="purchased-{{ ai_gen_id }}">
          {{ block.settings.purchased_label }}
        </label>
        <select
          id="purchased-{{ ai_gen_id }}"
          name="contact[purchased]"
          class="ai-customer-form__select-{{ ai_gen_id }}"
        >
          <option value="">{{ block.settings.purchased_placeholder }}</option>
          <option value="yes" {% if form.purchased == 'yes' %}selected{% endif %}>Yes</option>
          <option value="no" {% if form.purchased == 'no' %}selected{% endif %}>No</option>
        </select>
      </div>
    </div>

    <div class="ai-customer-form__button-wrapper-{{ ai_gen_id }}">
      <button type="submit" class="ai-customer-form__button-{{ ai_gen_id }}">
        {{ block.settings.submit_button_text }}
      </button>
    </div>

    {% if form.posted_successfully? %}
      <div class="ai-customer-form__success-{{ ai_gen_id }}">
        {{ block.settings.success_message }}
      </div>
    {% endif %}

    {% if form.errors %}
      <div class="ai-customer-form__error-{{ ai_gen_id }}">
        {{ form.errors.messages | first }}
      </div>
    {% endif %}
  {% endform %}
</div>

