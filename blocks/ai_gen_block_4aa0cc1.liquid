{% doc %}
  @prompt
    I need a horizontal layout divided into five columns to showcase different user benefits, and it should allow me to insert icons representing each benefit., Need a  section title, I need a horizontal layout divided into five columns to showcase different user benefits, and it should allow me to insert icons representing each benefit,also with a big title
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-showcase-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-benefits-showcase-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-benefits-showcase-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: {{ block.settings.title_bottom_spacing }}px;
  }

  .ai-benefits-showcase-heading-{{ ai_gen_id }} {
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-benefits-showcase-subtitle-{{ ai_gen_id }} {
    font-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: {{ block.settings.subtitle_top_spacing }}px 0 0;
    line-height: 1.5;
  }

  .ai-benefits-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.content_top_spacing }}px;
  }

  .ai-benefits-showcase-column-{{ ai_gen_id }} {
    text-align: {{ block.settings.content_alignment }};
    padding: {{ block.settings.column_padding }}px;
    background-color: {{ block.settings.column_background_color }};
    border-radius: {{ block.settings.column_border_radius }}px;
    border: {{ block.settings.column_border_width }}px solid {{ block.settings.column_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-benefits-showcase-column-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-benefits-showcase-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_bottom_spacing }}px;
    display: block;
    object-fit: contain;
  }

  .ai-benefits-showcase-icon-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_bottom_spacing }}px;
    background-color: {{ block.settings.icon_placeholder_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_placeholder_text_color }};
    font-size: {{ block.settings.icon_size | divided_by: 2 }}px;
  }

  .ai-benefits-showcase-benefit-title-{{ ai_gen_id }} {
    font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }};
    font-size: {{ block.settings.benefit_title_size }}px;
    color: {{ block.settings.benefit_title_color }};
    margin: 0 0 {{ block.settings.benefit_title_bottom_spacing }}px;
    line-height: 1.3;
  }

  .ai-benefits-showcase-benefit-description-{{ ai_gen_id }} {
    font-family: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
    font-size: {{ block.settings.benefit_description_size }}px;
    color: {{ block.settings.benefit_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 990px) {
    .ai-benefits-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
    }

    .ai-benefits-showcase-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-benefits-showcase-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-benefits-showcase-column-{{ ai_gen_id }} {
      padding: {{ block.settings.column_padding | times: 0.7 }}px;
    }

    .ai-benefits-showcase-icon-{{ ai_gen_id }},
    .ai-benefits-showcase-icon-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-benefits-showcase-icon-placeholder-{{ ai_gen_id }} {
      font-size: {{ block.settings.icon_size | times: 0.8 | divided_by: 2 }}px;
    }
  }
{% endstyle %}

<div class="ai-benefits-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-showcase-container-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank or block.settings.main_subtitle != blank %}
      <div class="ai-benefits-showcase-title-{{ ai_gen_id }}">
        {% if block.settings.main_title != blank %}
          <h2 class="ai-benefits-showcase-heading-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
        {% endif %}
        {% if block.settings.main_subtitle != blank %}
          <p class="ai-benefits-showcase-subtitle-{{ ai_gen_id }}">{{ block.settings.main_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-benefits-showcase-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign benefit_icon_key = 'benefit_' | append: i | append: '_icon'
          assign benefit_title_key = 'benefit_' | append: i | append: '_title'
          assign benefit_description_key = 'benefit_' | append: i | append: '_description'

          assign benefit_icon = block.settings[benefit_icon_key]
          assign benefit_title = block.settings[benefit_title_key]
          assign benefit_description = block.settings[benefit_description_key]
        %}

        <div class="ai-benefits-showcase-column-{{ ai_gen_id }}">
          {% if benefit_icon %}
            <img
              src="{{ benefit_icon | image_url: width: block.settings.icon_size | times: 2 }}"
              alt="{{ benefit_title | escape }}"
              class="ai-benefits-showcase-icon-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
            >
          {% else %}
            <div class="ai-benefits-showcase-icon-placeholder-{{ ai_gen_id }}">
              {{ i }}
            </div>
          {% endif %}

          {% if benefit_title != blank %}
            <h3 class="ai-benefits-showcase-benefit-title-{{ ai_gen_id }}">{{ benefit_title }}</h3>
          {% endif %}

          {% if benefit_description != blank %}
            <p class="ai-benefits-showcase-benefit-description-{{ ai_gen_id }}">{{ benefit_description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

