{%- liquid
  if customer
    assign profile_link = routes.account_url
    assign profile_text = 'sections.header.my_account' | t
  else
    assign profile_link = routes.account_login_url
    assign profile_text = 'sections.header.login' | t
  endif
  assign mobile_profile_link = header_settings.header_profile_link | default: profile_link
-%}

<div class="thb-secondary-area thb-header-right">
  {%- if shop.customer_accounts_enabled -%}
    <a
      class="thb-secondary-area-item thb-secondary-myaccount"
      href="{{ profile_link | escape }}"
      title="{{ 'sections.header.my_account' | t }}"
    >
      <span class="button white button-new-login">
        {%- render 'icon-sign' -%}
        {%- if header_settings.signup_cta_text != blank -%}
          {{ header_settings.signup_cta_text -}}
        {%- else -%}
          {{ profile_text -}}
        {%- endif -%}
      </span>
    </a>
  {%- endif -%}
  <a
    class="thb-secondary-area-item thb-quick-search"
    href="{{ routes.search_url }}"
    title="{{ 'sections.header.search' | t }}"
  >
    {%- render 'svg-icons' with 'search' -%}
  </a>
  {%- unless header_settings.style == 'style4' -%}
    <div class="thb-secondary-area-item thb-header-localization no-js-hidden">
      {%- render 'localization',
        id: 'HeaderLocalization',
        show_language_switcher: header_settings.show_language_switcher,
        show_currency_switcher: header_settings.show_currency_switcher,
        class: 'inside-header'
      -%}
    </div>
  {%- endunless -%}
  <a
    class="thb-secondary-area-item thb-secondary-mobile-profile-link"
    href="{{ mobile_profile_link | escape }}"
    title="Profile link"
    aria-label="Profile link"
  >
    {%- render 'icon-account' -%}
  </a>
  {% comment %}
   只保留可加文字的那一个头像，另一个头像去掉， 
   {%- if header_settings.header_profile_link != blank -%}
    <a
      class="thb-secondary-area-item thb-secondary-profile-link"
      href="{{ header_settings.header_profile_link }}"
      title="Profile link"
      aria-label="Profile link"
    >
      {%- render 'icon-account', stroke_style: true -%}
    </a>
  {%- endif -%} 
  {% endcomment %}
  <a class="thb-secondary-area-item thb-secondary-cart" href="{{ routes.cart_url }}" id="cart-drawer-toggle">
    <div class="thb-secondary-item-icon">
      {%- render 'svg-icons' with 'header-cart' %}
      <span class="thb-item-count">
        {%- if cart.item_count > 99 -%}
          {%- render 'svg-icons' with 'thb-asterisk' -%}
        {%- else -%}
          {{ cart.item_count }}
        {%- endif -%}
      </span>
    </div>
  </a>
</div>
