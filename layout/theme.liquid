     <script type="text/javascript">
    // Clarity 延迟到 load 后的浏览器空闲时再加载：clarity() 队列 API 立即可用，
    // 早期调用会被缓存并在脚本就绪后回放，仅把脚本下载/执行移出首屏关键路径以降低 TBT。
    // 行为分析（热图/录屏）会少录开头几秒，对数据价值影响可忽略。
    (function(c,l,a,r,i){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        function loadClarity(){
            var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        }
        window.addEventListener('load', function(){
            if('requestIdleCallback' in window){
                requestIdleCallback(loadClarity, {timeout:5000});
            } else {
                setTimeout(loadClarity, 3000);
            }
        });
    })(window, document, "clarity", "script", "nje1e0f1tq");
</script>
