	<script>
		// 延迟加载 Tidio 在线客服：首次用户交互或页面空闲时再加载，
		// 把它约 500KB 的体积移出首屏关键路径（不影响客服功能可用性）。
		(function () {
			var loaded = false;
			var events = ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'];
			function loadTidio() {
				if (loaded) return;
				loaded = true;
				events.forEach(function (e) { window.removeEventListener(e, loadTidio); });
				var s = document.createElement('script');
				s.src = '//code.tidio.co/hseljmlfdl0lhccwh9hoak9c1sntq1gj.js';
				s.async = true;
				document.body.appendChild(s);
			}
			events.forEach(function (e) { window.addEventListener(e, loadTidio, { passive: true }); });
			// 兜底：即使用户没有交互，也在 load 之后趁浏览器空闲时加载
			window.addEventListener('load', function () {
				if ('requestIdleCallback' in window) {
					requestIdleCallback(loadTidio, { timeout: 5000 });
				} else {
					setTimeout(loadTidio, 4000);
				}
			});
		})();
	</script>
