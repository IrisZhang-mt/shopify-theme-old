{% style %}
  .image-with-text-overlay{position:relative}
  .image-with-text-overlay__stretched-link{position:absolute;inset:0;z-index:2}
  .image-with-text-overlay--content{pointer-events:none}
  .image-with-text-overlay--content a,.image-with-text-overlay--content button{pointer-events:auto}
{% endstyle %}
{{- 'image-with-text-overlay.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign section_width = section.settings.section_width
	assign section_heading = section.settings.section_heading
	assign image = section.settings.image
	assign mobile_image = section.settings.mobile_image
	assign image_parallax = section.settings.image_parallax
	assign desktop_height_mode = section.settings.desktop_height_mode
	assign desktop_fixed_height = section.settings.desktop_fixed_height
	assign mobile_height_mode = section.settings.mobile_height_mode
	assign mobile_fixed_height = section.settings.mobile_fixed_height
	assign content_width = section.settings.content_width
	assign content_position = section.settings.content_position
	assign text_alignment = section.settings.text_alignment
	assign content_style = section.settings.content_style
	assign overlay_opacity = section.settings.overlay_opacity
	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing
	assign desktop_ratio_width = section.settings.desktop_ratio_width
	assign desktop_ratio_height = section.settings.desktop_ratio_height
	assign mobile_ratio_width = section.settings.mobile_ratio_width
	assign mobile_ratio_height = section.settings.mobile_ratio_height

	if desktop_height_mode == 'auto' and image
		assign desktop_ratio_width = image.src.width
		assign desktop_ratio_height = image.src.height
	endif

	if mobile_height_mode == 'auto'
		if mobile_image
			assign mobile_ratio_width = mobile_image.src.width
			assign mobile_ratio_height = mobile_image.src.height
		elsif image
			assign mobile_ratio_width = image.src.width
			assign mobile_ratio_height = image.src.height
		endif
	endif

	assign priority = false

	if section.index == 1
		assign priority = 'high'
	endif
-%}
<div class="row {{ section_width }}">
	<div class="small-12 columns">
		{%- if section_heading != blank -%}
			<div class="image-with-text-overlay__section-heading-wrap">
				<h2 class="image-with-text-overlay__section-heading">{{ section_heading }}</h2>
			</div>
		{%- endif -%}
		<image-with-text-overlay class="image-with-text-overlay text-{{ text_alignment }} content-style-{{ content_style }} desktop-height-mode-{{ desktop_height_mode }} mobile-height-mode-{{ mobile_height_mode }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" style="--overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }}; --image-with-text-overlay-desktop-ratio: {{ desktop_ratio_width }} / {{ desktop_ratio_height }}; --image-with-text-overlay-mobile-ratio: {{ mobile_ratio_width }} / {{ mobile_ratio_height }};">
			{%- liquid
  assign stretched_link = ''
  for block in section.blocks
    if block.type == 'button' and block.settings.button_link != blank and stretched_link == ''
      assign stretched_link = block.settings.button_link
    endif
  endfor
-%}
{%- if stretched_link != blank -%}
  <a class="image-with-text-overlay__stretched-link" href="{{ stretched_link }}" aria-hidden="true" tabindex="-1"></a>
{%- endif -%}
			<div class="image-with-text-overlay--bg parallax--{{ image_parallax }}">
				{% if image %}
					{%- liquid
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '750x,' | append: '1600x,' | append: master_width

						assign class = ''
						if image_parallax
							assign class = 'thb-parallax-image'
						endif

						if mobile_image
							assign class = class | append: ' image-with-text-overlay--desktop'
						endif
					-%}
					{%- render 'responsive-image', image: image, sizes: width, class: class, priority: priority -%}
				{% else %}
					{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder_svg_tag' }}
				{% endif %}
				{%- if mobile_image -%}
					{%- liquid
						assign image = mobile_image
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '750x,' | append: master_width

						assign class = ''
						if image_parallax
							assign class = 'thb-parallax-image'
						endif

						assign class = class | append: ' image-with-text-overlay--mobile'
						render 'responsive-image', image: image, sizes: width, class: class, priority: priority
					-%}
				{%- endif -%}
			</div>

			<div class="image-with-text-overlay--content content-{{ content_position }}">
				<div class="image-with-text-overlay--content-inner content-width-{{ content_width }}">
					{% for block in section.blocks %}
						{%- case block.type -%}
							{%- when 'subheading' -%}
								<p class="subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
							{%- when 'heading' -%}
								<h3 class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.text | newline_to_br }}</h3>
							{%- when 'text' -%}
								<div class="rte description-size--{{ block.settings.description_size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
							{%- when 'button' -%}
								{% if block.settings.button_text != blank %}
									{% if block.settings.button_style == 'link' %}
										<a class="image-with-text-overlay__link-button text-button white" href="{{ block.settings.button_link }}" role="button" title="{{ block.settings.button_text | escape }}" {{ block.shopify_attributes }}>
											<span>{{ block.settings.button_text }}</span>
											{%- render 'svg-icons' with 'thb-inline-link-arrow' -%}
										</a>
									{% else %}
										<a class="button white{% if block.settings.button_outline %} outline{%- endif %}" href="{{ block.settings.button_link }}" role="button" title="{{ block.settings.button_text | escape }}" {{ block.shopify_attributes }}><span>{{ block.settings.button_text }}</span></a>
									{% endif %}
								{% endif %}
							{% when 'space' %}
		            <div style="height: {{ block.settings.height | append: 'px' }}" {{ block.shopify_attributes }}></div>
						{%- endcase -%}
					{% endfor %}
				</div>
			</div>
		</image-with-text-overlay>
	</div>
</div>
<script src="{{ 'image-with-text-overlay.js' | asset_url }}" defer="defer"></script>
{% schema %}
  {
    "name": "Image with text overlay",
		"class": "section-image-with-text-overlay",
    "settings": [
			{
				"type": "select",
				"id": "section_width",
				"options": [
					{
						"value": "grid",
						"label": "Grid"
					},
					{
						"value": "full-width-row",
						"label": "Full width"
					},
					{
						"value": "full-width-row-full",
						"label": "Full width, no spacing"
					}
				],
				"default": "grid",
				"label": "Section width"
			},
			{
				"type": "text",
				"id": "section_heading",
				"label": "Section heading"
			},
			{
				"type": "image_picker",
				"id": "image",
				"label": "Image",
				"info": "2800 x 650 .jpg recommended."
			},
			{
				"type": "image_picker",
				"id": "mobile_image",
				"label": "Mobile image (optional)",
				"info": "375 x 650 .jpg recommended."
			},
			{
				"type": "checkbox",
				"id": "image_parallax",
				"default": false,
				"label": "Enable parallax",
				"info": "Animations must be enabled in theme settings"
			},
			{
				"type": "select",
				"id": "desktop_height_mode",
				"label": "Desktop height mode",
				"options": [
					{
						"value": "auto",
						"label": "Adapt to image"
					},
					{
						"value": "fixed",
						"label": "Fixed height"
					}
				],
				"default": "auto"
			},
			{
				"type": "select",
				"id": "mobile_height_mode",
				"label": "Mobile height mode",
				"options": [
					{
						"value": "auto",
						"label": "Adapt to image"
					},
					{
						"value": "fixed",
						"label": "Fixed height"
					}
				],
				"default": "auto"
			},
			{
				"type": "range",
				"id": "mobile_fixed_height",
				"min": 250,
				"max": 900,
				"step": 10,
				"unit": "px",
				"label": "Mobile fixed height",
				"default": 500
			},
			{
				"type": "number",
				"id": "desktop_ratio_width",
				"default": 1440,
				"label": "Desktop ratio width",
				"info": "Used with desktop ratio height to define desktop aspect ratio when in Fixed height mode."
			},
			{
				"type": "number",
				"id": "desktop_ratio_height",
				"default": 650,
				"label": "Desktop ratio height",
				"info": "Used with desktop ratio width to define desktop aspect ratio when in Fixed height mode."
			},
			{
				"type": "range",
				"id": "mobile_ratio_width",
				"min": 120,
				"max": 600,
				"step": 5,
				"unit": "px",
				"default": 390,
				"label": "Mobile ratio width",
				"info": "Used with mobile ratio height to define mobile aspect ratio when in Fixed height mode."
			},
			{
				"type": "range",
				"id": "mobile_ratio_height",
				"min": 120,
				"max": 600,
				"step": 5,
				"unit": "px",
				"default": 295,
				"label": "Mobile ratio height",
				"info": "Used with mobile ratio width to define mobile aspect ratio when in Fixed height mode."
			},
			{
	      "type": "header",
	      "content": "Content style"
	    },
			{
				"type": "select",
				"id": "content_style",
				"label": "Content style",
				"options": [
					{
						"value": "default",
						"label": "Theme default"
					},
					{
						"value": "editorial-center",
						"label": "Centered editorial"
					}
				],
				"default": "default"
			},
			{
				"type": "select",
				"id": "content_width",
				"label": "Content width",
				"options": [
					{
						"value": "small",
						"label": "Small"
					},
					{
						"value": "medium",
						"label": "Medium"
					},
					{
						"value": "large",
						"label": "Large"
					}
				],
				"default": "medium"
			},
			{
				 "type": "select",
				 "id": "content_position",
				 "label": "Content position",
				 "options": [
					 { "value": "middle-left", "label": "Middle left" },
					 { "value": "middle-center", "label": "Middle center" },
					 { "value": "middle-right", "label": "Middle right" },
					 { "value": "bottom-left", "label": "Bottom left" },
					 { "value": "bottom-center", "label": "Bottom center" },
					 { "value": "bottom-right", "label": "Bottom right" }
				 ],
				 "default": "bottom-center"
			},
			{
				"type": "select",
				"id": "text_alignment",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "center",
				"label": "Content alignment"
			},
			{
				"type": "range",
				"id": "overlay_opacity",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "%",
				"label": "Overlay opacity",
				"default": 30
			},
			{
	      "type": "header",
	      "content": "Spacing"
	    },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
    "blocks": [
			{
				"type": "subheading",
				"name": "Subheading",
				"limit": 1,
				"settings": [
					{
						"type": "text",
						"id": "text",
						"label": "Text",
						"default": "Add a tagline"
					}
				]
			},
			{
				"type": "heading",
				"name": "Heading",
				"limit": 1,
				"settings": [
					{
						"type": "text",
						"id": "text",
						"label": "Text",
						"default": "Image with text overlay"
					},
					{
						"type": "select",
						"id": "heading_size",
						"label": "Size",
						"options": [
							{
								"value": "h2",
								"label": "Small"
							},
							{
								"value": "h1",
								"label": "Medium"
							},
							{
								"value": "h1-large",
								"label": "Large"
							},
							{
								"value": "h1-xlarge",
								"label": "Extra large"
							}
						],
						"default": "h1-xlarge"
					}
				]
			},
			{
        "type": "text",
        "name": "Text",
				"limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Content",
            "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
          },
					{
						"type": "select",
						"id": "description_size",
						"label": "Size",
						"options": [
							{
								"value": "small",
								"label": "Small"
							},
							{
								"value": "medium",
								"label": "Medium"
							},
							{
								"value": "large",
								"label": "Large"
							}
						],
						"default": "medium"
					}
        ]
      },
			{
        "type": "button",
        "name": "Button",
				"limit": 2,
        "settings": [
					{
						"id": "button_text",
						"type": "text",
						"label": "Button label",
						"default": "Shop Now",
						"info": "Leave the label blank to hide the button."
					},
					{
						"id": "button_link",
						"type": "url",
						"label": "Button link"
					},
					{
						"type": "checkbox",
						"id": "button_outline",
						"label": "Use outline button style",
						"default": false
					},
					{
						"type": "select",
						"id": "button_style",
						"label": "Button style",
						"options": [
							{
								"value": "pill",
								"label": "Pill button"
							},
							{
								"value": "link",
								"label": "Link with arrow"
							}
						],
						"default": "pill"
					}
        ]
      },
      {
        "type": "space",
        "name": "Empty space",
        "settings": [
          {
            "type": "range",
            "id": "height",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Height",
            "default": 50
          }
        ]
      }
    ],
  	"max_blocks": 5,
    "presets": [
      {
        "name": "Image with text overlay",
				"blocks": [
					{
						"type": "subheading"
					},
					{
						"type": "heading"
					},
					{
						"type": "text"
					},
					{
						"type": "button"
					}
				]
      }
    ]
  }
{% endschema %}
