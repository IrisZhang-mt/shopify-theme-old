{{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}
<style>
     .index_WhyChooseAll .swiper-pagination-bullet {
        border-radius: unset !important;
    }
    .index_WhyChooseBottom_pcBox_left {
        display: block;
    }
    .index_WhyChooseBottom_pcBox_left img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .index_WhyChooseBottom_pcBox_rightTitle {
        margin: 0;
        line-height: 120%;
    }
    .index_WhyChooseBottom_pcBox_rightText {
        line-height: 140%;
    }
    @media(max-width:999px) {
        #shopify-section-{{section.id}}.index_WhyChooseAll{
            margin-top: {{section.settings.Mobile_top}}px;
            margin-bottom: {{section.settings.Mobile_bottom}}px;

            padding-top:{{section.settings.Mobile_paddingTop}}px;
            padding-bottom:{{section.settings.Mobile_paddingBottom}}px;
        }
    }
    @media(min-width:1000px) {
        
        #shopify-section-{{section.id}}.index_WhyChooseAll{
            margin-top: {{section.settings.Desktop_top}}px;
            margin-bottom: {{section.settings.Desktop_bottom}}px;

            padding-top:{{section.settings.Desktop_paddingTop}}px;
            padding-bottom:{{section.settings.Desktop_paddingBottom}}px;
        }
    }
    @media (min-width:1000px) {
        .pad_mobile{
            display: none;
        }
        .index_WhyChooseTitle{
            text-align: center;
            margin: 0;
            margin-bottom: 80px;
        }
        .index_WhyChooseBottom_pcBox {
            display: flex;
        }
        .index_WhyChooseBottom_pcBox_left {
            width: 50%;
            overflow: hidden;
        }
        .index_WhyChooseBottom_pcBox_left img {
            transition: all 0.5s;
        }
        .index_WhyChooseBottom_pcBox_left:hover img{
            transform: scale(1.05);
        }
        .index_WhyChooseBottom_pcBox_right {
            width: 50%;
            padding: 52px 60px;
        }
        .index_WhyChooseBottom_pcBox_rightTitle {
            font-size: 20px;
            font-weight: 500;
        }
        .index_WhyChooseBottom_pcBox_rightText {
            margin-top: 10px;
        }
        #shopify-section-{{section.id}} .index_WhyChooseBottom_pcBoxs {
            flex-direction: row-reverse;
        }
        .index_WhyChooseBottom_pcBox_rightBox {
            max-width: 767px;
        }
    }

    @media (max-width:999px) {
        .pad_pc{
            display: none;
        }
        .my_m_16 {
            font-size: 16px;
        }
        .my_m_12 {
            font-size: 12px;
        }
        .index_WhyChooseTitle {
            text-align: center;
            line-height: 120%;
            margin-bottom: 20px;
        }
        .index_WhyChooseBottom_pcBox_rightTitle {
            font-weight: 500;
        }
        .index_WhyChooseBottom_pcBox_rightText {
            margin-top: 5px;
        }
        .index_WhyChooseBottom_pcBox {
            height: auto !important;
        }
        .index_WhyChooseBottom_pcBox_right {
            padding: 15px 17px;
        }
        .index_WhyChooseAll .swiper-pagination {
            position: static;
            margin-top: 0px;
            line-height: 1;
        }
        .index_WhyChooseAll .swiper-pagination-bullet {
            width: 34px;
            height: 1px;
            margin: 0 5px !important;
            opacity: 1;
            background-color: #e3e3e3;
        }
        .index_WhyChooseAll .swiper-pagination-bullet-active {
            background-color: #000;
        }
    }
</style>
<div class="index_WhyChooseAll" id="shopify-section-{{section.id}}">
    <div class="{% if section.settings.full_width %} {%- else -%} row full-width-row{% endif %}">
        <div class="columns">
            {% if section.settings.title !=blank %}
                <h2 class="index_WhyChooseTitle h3 my_m_25">
                    {{section.settings.title}}
                </h2>
            {% endif %}
            <div class="index_WhyChooseBottom">
                <div class="pad_pc">
                    <div class="index_WhyChooseBottom_pc">
                        {% for block in section.blocks %}
                            <div class="index_WhyChooseBottom_pcBox {% if block.settings.exchange_positions %} index_WhyChooseBottom_pcBoxs{% endif %}" style="background-color: {{block.settings.bg_color}} !important;">
                                <a href="{%- if block.settings.link !=blank -%}{{block.settings.link}} {%- else -%} javascript:void(0){%- endif -%}" class="index_WhyChooseBottom_pcBox_left">
                                    <img src="{{ block.settings.img | img_url: '1000x' }}" class="" alt="{{block.settings.img.alt}}">
                                </a>
                                <div class="index_WhyChooseBottom_pcBox_right" style="color: {{block.settings.text_color}} !important;">
                                    <div class="index_WhyChooseBottom_pcBox_rightBox">
                                        {% if block.settings.title !=blank %}
                                            <h5 class="index_WhyChooseBottom_pcBox_rightTitle my_h_20">
                                                {{block.settings.title}}
                                            </h5>
                                        {% endif %}
                                        {% if block.settings.text !=blank %}
                                            <div class="index_WhyChooseBottom_pcBox_rightText">
                                                {{block.settings.text}}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="pad_mobile">
                    <div class="index_WhyChooseBottom_pc swiper WhyChooseSwiper">
                        {% assign block_counter = 0 %}
                        <div class="swiper-wrapper">
                            {% for block in section.blocks %}
                            <div class="swiper-slide index_WhyChooseBottom_pcBox" style="background-color: {{block.settings.bg_color}} !important;">
                                <a href="{%- if block.settings.link !=blank -%}{{block.settings.link}} {%- else -%} javascript:void(0){%- endif -%}" class="index_WhyChooseBottom_pcBox_left">
                                    <img src="{{ block.settings.img_mobile | img_url: '750x' }}" class="" alt="{{block.settings.img_mobile.alt}}">
                                </a>
                                <div class="index_WhyChooseBottom_pcBox_right" style="color: {{block.settings.text_color}} !important;">
                                    {% if block.settings.title !=blank %}
                                        <h5 class="index_WhyChooseBottom_pcBox_rightTitle my_m_16">
                                            {{block.settings.title}}
                                        </h5>
                                    {% endif %}
                                    {% if block.settings.text !=blank %}
                                        <div class="index_WhyChooseBottom_pcBox_rightText my_m_12">
                                            {{block.settings.text}}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>  
                        <div class="pad_mobile">
                            <div class="swiper-pagination"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
 document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('#shopify-section-{{ section.id }} .WhyChooseSwiper', {
        observer: true,  //开启动态检查器，监测swiper和slide
        observeParents: true,  //监测Swiper 的祖/父元素  
        slidesPerView: 1, 
        spaceBetween: 10,
        mousewheel: {
            forceToAxis: true,
        },
        pagination: {
            el: '#shopify-section-{{section.id}} .swiper-pagination',
            clickable: true,
        }
    });
});
</script>
