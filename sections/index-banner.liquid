<style>
    .ThemeBannerBox video, .ThemeBannerBox img {
        width: 100%;
    }
    .ThemeBannerBoxPosition_title {
        margin: 0;
    }
    .ThemeBannerBox{
        position: relative;
    }
    #shopify-section-{{ section.id }} .ThemeBannerBoxPosition{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
    #shopify-section-{{ section.id }} .ThemeBannerBoxPosition_title,#shopify-section-{{ section.id }} .ThemeBannerBoxPosition_text {
        color: {{section.settings.text_color}}!important;
    }
    #shopify-section-{{ section.id }} .ThemeBannerBoxPosition_box{
        display: flex;
        height: 100%;
        width: 100%;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        padding-top: 40px;
        padding-bottom: 40px;
    }
    .ThemeBannerBoxPosition_text{
        margin-top: 20px;
    }
    .ThemeBannerBoxPosition_title{
        line-height: 120%;
    }
    @media (min-width:1000px) {
        .pad_mobile{
            display: none;
        }
    }
    @media (max-width:999px) {
        .pad_pc{
            display: none;
        }
        #shopify-section-{{ section.id }} .ThemeBannerBoxPosition_box{ 
            justify-content: flex-end;
        }
        .ThemeBannerBoxPosition_text{
            margin-top: 10px;
        }
        .ThemeBannerAll .my_m_25 {
            font-size: 25px; 
        }
        .ThemeBannerAll .my_m_12 {
            font-size: 12px;
        }
    }
</style>
<div class="ThemeBannerAll" id="shopify-section-{{ section.id }}">
    <div class="ThemeBannerBox">
        {% if section.settings.img != blank %}
            <img src="{{ section.settings.img | img_url: '1920x' }}" alt="{{section.settings.img.alt}}" class="pad_pc">
        {% endif %} 

        {% if section.settings.img_mobile != blank %}
            <img  src="{{ section.settings.img_mobile | img_url: '750x' }}" alt="{{section.settings.img_mobile.alt}}" class="pad_mobile">
        {% endif %}  
        <div class="ThemeBannerBoxPosition row full-width-row">
            <div class="ThemeBannerBoxPosition_box columns">
                {% if section.settings.title !=blank %}
                <h1 class="ThemeBannerBoxPosition_title my_h_55 my_m_25"> 
                    {{section.settings.title}}
                </h1>
                {% endif %}
                {% if section.settings.text !=blank %}
                    <div class="ThemeBannerBoxPosition_text my_h_22 my_m_12"> 
                        {{section.settings.text}}
                    </div>
                {% endif %}
            </div>
        </div>  
    </div>
</div>

{% schema %}
{
"name": "Theme Banner",
"class": "Theme Banner",
"presets": [{
    "name": "Theme Banner",
    "settings": {
        
    }
}],
"settings": [ 
    {
        "type": "image_picker",
        "id": "img",
        "label": "image"
    },
    {
        "type": "image_picker",
        "id": "img_mobile",
        "label": "image mobile"
    },
    {
        "type": "textarea",
        "id": "title",
        "label": "title"
    },
    {
        "type": "textarea",
        "id": "text",
        "label": "text"
    },
    {
        "type": "color",
        "id": "text_color",
        "label": "text color",
        "default": "#fff"
    }
    
]
}
{% endschema %}