<div class="index_ProductIntroductionAll shopify-section-{{section.id}}" data-tab="{{section.settings.tab_id}}">
    <div class="{% if section.settings.full_width %} {%- else -%} row full-width-row{% endif %}">
        <div class="columns">
            <div class="index_ProductIntroductionBanner">
                <div class="index_ProductIntroductionBanner_left">
                    <div class="index_ProductIntroductionBanner_leftBox">
                        {% if section.settings.label !=blank %}
                            <div class="index_ProductIntroductionBanner_leftLabel my_h_20 my_m_14">
                                {{section.settings.label}}
                            </div>
                        {% endif %}
                        {% if section.settings.title !=blank %}
                            <h1 class="index_ProductIntroductionBanner_leftTitle my_m_25">
                                {{section.settings.title}}
                            </h1>
                        {% endif %}
                        {% if section.settings.text !=blank %}
                            <div class="index_ProductIntroductionBanner_leftText my_m_12">
                                {{section.settings.text}}
                            </div>
                        {% endif %}
                        
                        <div class="ProductIntroductionBanner_leftPerfect">
                            {% if section.settings.perfect_for !=blank %}
                                <div class="ProductIntroductionBanner_leftPerfect_title my_h_20 my_m_14">
                                    {{section.settings.perfect_for}}
                                </div>
                            {% endif %}
                            <div class="ProductIntroductionBanner_leftPerfect_text">
                                {% for block in section.blocks %}
                                    {%- case block.type -%}
                                        {%- when 'text' -%}
                                            {% if block.settings.text !=blank %}
                                                <div class="ProductIntroductionBanner_leftPerfect_textBox my_m_12">
                                                    {{block.settings.text}}
                                                </div>
                                            {% endif %}
                                        {%- endcase -%}
                                    {% endfor %}
                            </div>
                        </div>
                        <div class="ProductIntroductionBanner_leftFeel">
                            {% if section.settings.feel !=blank %}
                                <div class="ProductIntroductionBanner_leftFeel_title my_h_20 my_m_14">
                                    {{section.settings.feel}}
                                </div>
                            {% endif %}
                            {% if section.settings.feel_img !=blank %}
                            <div class="ProductIntroductionBanner_leftFeel_img">
                                <img src="{{ section.settings.feel_img | img_url: '1000x' }}" class="" alt="{{section.settings.feel_img.alt}}">
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <a href="{{section.settings.link}}" class="index_ProductIntroductionBanner_right">
                    <div class="index_ProductIntroductionBanner_rightImg">
                        <img src="{{ section.settings.img | img_url: '1000x' }}" class="pad_pc" alt="{{section.settings.img.alt}}">
                        <img src="{{ section.settings.img_mobile | img_url: '750x' }}" class="pad_mobile" alt="{{section.settings.img_mobile.alt}}">
                    </div>
                    {% if section.settings.button !=blank %}
                        <div class="index_ProductIntroductionBanner_rightLink">
                            <div class="index_ProductIntroductionBanner_rightLinkBox my_h_16 my_m_12">
                                {{section.settings.button}}
                            </div>
                        </div>
                    {% endif %}
                </a>
            </div>
            <div class="index_ProductIntroductionBottom">
                <div class="swiper ProductIntroductionSwiper">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                            {%- case block.type -%}
                                {%- when 'bottom_img' -%}
                                <div class="swiper-slide index_ProductIntroductionBottom_box">
                                    <div class="index_ProductIntroductionBottom_boxImg">
                                        <img src="{{ block.settings.img | img_url: '1000x' }}" class="pad_pc" alt="{{block.settings.img.alt}}">
                                        <img src="{{ block.settings.img_mobile | img_url: '750x' }}" class="pad_mobile" alt="{{block.settings.img_mobile.alt}}">
                                    </div>
                                    <div class="index_ProductIntroductionBottom_boxText">
                                        {% if block.settings.svg !=blank %}
                                        <div class="index_ProductIntroductionBottom_boxText_left">
                                            <img src="{{ block.settings.svg | img_url: '200x' }}" alt="{{block.settings.svg.alt}}">
                                        </div>
                                        {% endif %}
                                        <div class="index_ProductIntroductionBottom_boxText_right">
                                            {% if block.settings.title !=blank %}
                                                <h5 class="index_ProductIntroductionBottom_boxText_rightTitle my_h_20 my_m_16">
                                                    {{block.settings.title}}
                                                </h5>
                                            {% endif %}
                                            {% if block.settings.text !=blank %}
                                                <div class="index_ProductIntroductionBottom_boxText_rightText my_m_12">
                                                    {{block.settings.text}}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {%- endcase -%}
                        {% endfor %}
                    </div>  
                    <div class="pad_mobile">
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
 document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('#shopify-section-{{ section.id }} .ProductIntroductionSwiper', {
        observer: true,  //开启动态检查器，监测swiper和slide
        observeParents: true,  //监测Swiper 的祖/父元素  
        mousewheel: {
            forceToAxis: true,
        },
        breakpoints: {
            300: {
                slidesPerView: 1, 
                spaceBetween: 5
            },
            768: {
                slidesPerView: 2, 
                spaceBetween: 5
            },
            1200: {
                slidesPerView: 3, 
                spaceBetween: 5
            }
        },
        pagination: {
            el: '.shopify-section-{{section.id}} .swiper-pagination',
            clickable: true,
        }
    });
});
</script>
