{{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}
<style>
    .seriesPage3_boxTop_imgText p {
        line-height: 1.3;
    }
    .seriesPage3_boxTop_imgBox img,.seriesPage3_boxTop_imgBox video,.seriesPage3_boxImg img {
        width: 100%;
    }
    @media(max-width:999px) {
        #shopify-section-{{section.id}} .seriesPage3All{
            margin-top: {{section.settings.Mobile_top}}px;
            margin-bottom: {{section.settings.Mobile_bottom}}px;

            padding-top:{{section.settings.Mobile_paddingTop}}px;
            padding-bottom:{{section.settings.Mobile_paddingBottom}}px;
        }
    }
    @media(min-width:1000px) {
        
        #shopify-section-{{section.id}} .seriesPage3All{
            margin-top: {{section.settings.Desktop_top}}px;
            margin-bottom: {{section.settings.Desktop_bottom}}px;

            padding-top:{{section.settings.Desktop_paddingTop}}px;
            padding-bottom:{{section.settings.Desktop_paddingBottom}}px;
        }
    }

    .seriesPage_container {
        max-width: 1320px;
        margin: 0 auto;
    }
    .seriesPage3_boxTop_smallText {
        line-height: 120%;
    }
    @media (min-width:1000px) {
        .seriesPage3All .loading-overlay {
            width: 26px;
            height: 26px;
        }
        .seriesPage3_title {
            text-align: center;
            font-weight: 500;
            line-height: 100%;
            margin-bottom: 60px;
        }
        .seriesPage3_boxTop_img {
            position: relative;
            border-radius: 30px;
            overflow: hidden;
        }
        #shopify-section-{{section.id}} .seriesPage3_boxTop_imgText {
            position: absolute;
            top: 44px;
            left: 44px;
            font-weight: 500;
            line-height: 120%;
            max-width: 582px;
            color: {{section.settings.text_color}};
        }
        #shopify-section-{{section.id}} .seriesPage3_boxTop_small{
            position: absolute;
            bottom: 44px;
            right: 44px;
            max-width: 750px;
            padding: 36px 32px 16px 56px;
            border-radius: 20px; 
            background-color: {{section.settings.small_bg_color}};
            color: {{section.settings.small_color}};
        }
        .seriesPage3_boxTop_smallBuyNow {
            cursor: pointer;
            border-radius: 100px;
            width: max-content;
            display: flex;
            height: 32px; 
            margin-top: 20px;
            justify-content: center;
            border: 1px solid #151515;
            padding: 0 20px;
            margin-left: auto;
            align-items: center;
        }
        .seriesPage3_bottom {
            margin-top: 24px;
        }
        .seriesPage3_Box {
            position: relative;
            border-radius: 30px;
            overflow: hidden;
        } 
        #shopify-section-{{section.id}} .seriesPage3_boxText {
            position: absolute;
            bottom: 0;
            left: 0; 
            right: 0;
            line-height: 120%;
            text-align: center;
            padding: 16px;
            color: {{section.settings.text_color}};
        }
    }

    @media (max-width:999px) {
        .seriesPage3All .loading-overlay {
            width: 20px;
            height: 20px;
        }
        .seriesPage3All .row.full-width-row,.seriesPage3All .row .columns{
            padding: 0;
        }
        
        .seriesPage3_title {
            text-align: center;
            font-weight: 500;
            line-height: 100%;
            margin-bottom: 30px;
        }
        .seriesPage3_boxTop_img {
            position: relative;
            border-radius: 13px;
            overflow: hidden;
        }
        #shopify-section-{{section.id}} .seriesPage3_boxTop_imgText {
            position: absolute;
            top: 15px;
            left: 15px;
            font-weight: 500;
            line-height: 120%;
            color: {{section.settings.text_color}};
        }
        #shopify-section-{{section.id}} .seriesPage3_boxTop_small{
            position: absolute;
            bottom: 15px;
            right: 15px;
            left: 15px;
            max-width: 750px;
            padding: 23px 10px 10px 23px;
            border-radius: 10px; 
            background-color: {{section.settings.small_bg_color}};
            color: {{section.settings.small_color}};
        }
        .seriesPage3_boxTop_smallBuyNow {
            cursor: pointer;
            border-radius: 100px;
            width: max-content;
            display: flex;
            height: 24px; 
            margin-top: 5px;
            justify-content: center;
            border: 1px solid #151515;
            padding: 0 20px;
            margin-left: auto;
            align-items: center;
        }
        .seriesPage3_bottom {
            margin-top: 12px;
        }
        .seriesPage3_Box {
            position: relative;
            border-radius: 13px;
            overflow: hidden;
        }
        #shopify-section-{{section.id}} .seriesPage3_boxText {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            line-height: 120%;
            text-align: center;
            padding: 8px 6px;
            color: {{section.settings.text_color}};
        }
 
    }
</style>
<div class="seriesPage3All">
    <div class="row full-width-row">
        <div class="columns">
            <div class="seriesPage_container">
                {% if section.settings.title !=blank %}
                    <h2 class="seriesPage4_title my_h_34 my_m_18">
                        {{section.settings.title}}
                    </h2>
                {% endif %}
                <div class="seriesPage3_box">
                    <div class="seriesPage3_boxTop_img">
                        <div class="seriesPage3_boxTop_imgBox">
                            <div class="pad_pc">
                                {% if section.settings.video !=blank %}
                                    {{ section.settings.video | video_tag: autoplay: autoplay, loop: true, controls: false, muted: true }}
                                {% else %}
                                    <img src="{{ section.settings.img | img_url: 'master' }}" alt="{{section.settings.img.alt}}">  
                                    
                                {% endif %}
                            </div>

                            <div class="pad_mobile"> 
                                {% if section.settings.video_mobile !=blank %}
                                    {{ section.settings.video_mobile | video_tag: autoplay: autoplay, loop: true, controls: false, muted: true }}
                                {% else %}
                                    <img src="{{ section.settings.img_mobile | img_url: 'master' }}" alt="{{section.settings.img_mobile.alt}}">  
                                    
                                {% endif %}
                            </div>
                        </div>
                        {% if section.settings.text !=blank %} 
                            <h3 class="seriesPage3_boxTop_imgText my_h_38 pad_pc">
                                {{section.settings.text}}
                            </h3>
                            <h3 class="seriesPage3_boxTop_imgText my_m_20 pad_mobile">
                                {{section.settings.text | strip_html }}
                            </h3>
                        {% endif %}
                        {% if section.settings.small_text !=blank %}
                            <div class="seriesPage3_boxTop_small">
                                <div class="seriesPage3_boxTop_smallText my_h_18 my_m_12">
                                    {{section.settings.small_text}}
                                </div>
                                {% if section.settings.small_buyNow !=blank %}
                                    <quick-view
                                        class="seriesPage3_boxTop_smallBuyNow my_h_16 my_m_12 "
                                        href="#Product-Drawer"
                                        data-product-handle="{{ section.settings.product.handle }}"
                                        tabindex="-1"
                                    >
                                        <div class="loading-overlay">{% render 'svg-icons' with 'thb-loading' %}</div>
                                        <span>
                                            {{section.settings.small_buyNow}}
                                        </span>
                                    </quick-view>  
                                {%- endif -%}        
                            </div>
                        {% endif %}
                    </div>
           
                    {% if section.blocks.size>0 %}
                        <div class="seriesPage3_bottom swiper seriesPage3Swiper">
                            <div class="swiper-wrapper">
                                {% for block in section.blocks %}
                                    <div class="seriesPage3_Box swiper-slide">
                                        <div class="seriesPage3_boxImg">
                                            <img src="{{ block.settings.img | img_url: 'master' }}" alt="{{block.settings.img.alt}}">
                                        </div>
                                        {% if block.settings.text !=blank %}
                                            <div class="seriesPage3_boxText my_h_18 my_m_12">
                                                {{block.settings.text}}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>  
            </div>
        </div>
    </div>
</div>
                  
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
 document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('#shopify-section-{{ section.id }} .seriesPage3Swiper', {
        observer: true,  //开启动态检查器，监测swiper和slide
        observeParents: true,  //监测Swiper 的祖/父元素  
        mousewheel: {
            forceToAxis: true,
        },
        breakpoints: {
            320: {
            //当屏幕宽度大于等于320
            slidesPerView: 1.8,
            spaceBetween: 12, 
            },
            768: {
             //当屏幕宽度大于等于768
                slidesPerView: 2,
                spaceBetween: 24,
            },
            1280: {
                //当屏幕宽度大于等于1280
                slidesPerView: 3, 
                spaceBetween: 24,
            },
        },
        pagination: {
            el: '#shopify-section-{{section.id}} .swiper-pagination',
            clickable: true,
        }
    });
});
</script>
