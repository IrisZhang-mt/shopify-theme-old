{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "section-customer-register",
	"settings": [
		{
			"type": "image_picker",
			"id": "section_image",
			"label": "Main image"
		},
  	{
			"type": "textarea",
			"id": "subscribe_text",
			"label": "subscribe text",
      "default": "Agree to subscribe to user push"
		}
	]
}
{% endschema %}