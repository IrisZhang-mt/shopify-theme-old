{{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}
{%- assign collapsible_tabs = section.blocks | where: 'type', 'collapsible_tab' -%}
{%- if collapsible_tabs -%}
  {{- 'collapsible-content.css' | asset_url | stylesheet_tag -}}
{%- endif -%}
{{- 'image-with-text.css' | asset_url | stylesheet_tag -}}
{%- liquid
  assign section_width = section.settings.section_width
  assign height = section.settings.height
  assign content_position = section.settings.content_position
  assign desktop_image_width = section.settings.desktop_image_width
  assign desktop_layout = section.settings.layout
  assign color_bg = section.settings.color_bg
  assign color_text = section.settings.color_text
  assign color_border = section.settings.color_border
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign cust_photo_frame_bg = section.settings.cust_photo_frame_bg
-%}
<div
  class="
    row {{ section_width }} cust-image-with-text-interactive-collection-list
    cust-image-with-text-interactive-collection-list-{{ section.id }}
  "
  style="--cust-photo-frame-bg: {{ cust_photo_frame_bg }}; overflow: hidden;"
>
  <div class="small-12 columns">
    <div
      class="image-with-text grid--image-{{ desktop_image_width }} {{ desktop_layout }} {{ content_position }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}"
      style="--color-bg:{{ color_bg }};--color-text:{{ color_text }};--color-text-rgb: {{ color_text | color_extract: 'red' }}, {{ color_text | color_extract: 'green' }}, {{ color_text | color_extract: 'blue' }}; --solid-button-background: {{ color_text }}; --outline-button-label: {{ color_text }};--solid-button-label: {{ color_bg }};--bg-body: {{ color_bg }};--color-border: {{ color_border }}"
    >
      <div class=" cl-w-full image-with-text__image image-with-text__inner">
        <div class="swiper swiper-images-{{ section.id }}" style="pointer-event: none;">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'interactive_coll_list' -%}
                {%- liquid
                  assign image = block.settings.image
                  assign mobile_image = block.settings.mobile_image | default: image
                  assign use_video = block.settings.use_video
                  assign video = block.settings.video
                  assign video_hosted = block.settings.video_hosted
                  assign video_autoplay = block.settings.video_autoplay
                  assign video_controls = block.settings.video_controls
                  assign ratio = 1
                  if height == 'adapt' and image != blank
                    assign ratio = image.aspect_ratio
                  endif

                  if height == 'adapt' and use_video
                    if video_hosted != blank
                      assign ratio = video_hosted.aspect_ratio
                    else
                      assign ratio = 16.00 | divided_by: 9.00
                    endif
                  endif
                -%}
                <div class="swiper-slide">
                  {%- if image != blank -%}
                    {{ image | image_url: width: 1800 | image_tag: class: 'desktop-only cl-img', fetchPriority: 'low' }}
                    {{
                      mobile_image
                      | image_url: width: 1800
                      | image_tag: class: 'mobile-only cl-img', fetchPriority: 'low'
                    }}
                  {%- else -%}
                    <div
                      class="
                        image-with-text__image-media aspect-ratio aspect-ratio--{{ height }}
                        media-{{ block.id }}
                      "
                      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
                    >
                      {%- if use_video -%}
                        {%- if video_hosted != blank -%}
                          {{
                            video_hosted
                            | video_tag:
                              autoplay: video_autoplay,
                              loop: true,
                              controls: video_controls,
                              muted: video_autoplay,
                              image_size: '690x'
                          }}
                        {%- elsif video != blank -%}
                          {%- if video.type == 'youtube' -%}
                            <iframe
                              data-src="https://www.youtube.com/embed/{{ video.id }}?loop=1{%- if video_autoplay -%}&autoplay=1&mute=1{%- endif -%}&playlist={{ video.id }}&iv_load_policy=3&disablekb=1&controls={{ video_controls }}&playsinline=1"
                              frameborder="0"
                              class="lazyload"
                              allow="autoplay; encrypted-media"
                              allowfullscreen
                              title="{{ section.settings.heading | escape }}"
                              tabindex="-1"
                            ></iframe>
                          {%- else -%}
                            <iframe
                              data-src="https://player.vimeo.com/video/{{ video.id }}{%- if video_autoplay -%}?background=1{%- endif -%}"
                              frameborder="0"
                              class="lazyload"
                              allow="autoplay; encrypted-media"
                              allowfullscreen
                              title="{{ section.settings.heading | escape }}"
                              tabindex="-1"
                            ></iframe>
                          {%- endif -%}
                        {%- endif -%}
                      {%- elsif image != blank -%}
                        {%- liquid
                          assign small_height = image.src.height | times: '690' | divided_by: image.src.width
                          assign mid_height = image.src.height | times: '1340' | divided_by: image.src.width
                          assign master_width = image.src.width | append: 'x' | append: image.src.height
                          assign width = '690x' | append: small_height | append: ',' | append: '1340x' | append: mid_height | append: ',' | append: master_width
                        -%}
                        {%- render 'responsive-image', image: image, sizes: width -%}
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder_svg_tag' }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="image-with-text__content image-with-text__inner">
        <div class="image-with-text__content--inner">
          {%- assign displayed_interactive_coll_list = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'interactive_coll_list' -%}
                {%- if displayed_interactive_coll_list == false -%}
                  {%- assign displayed_interactive_coll_list = true -%}
                  <div class="cust-ic-list">
                    <div
                      class="cust-ic-list-inner"
                    >
                      {%- assign counter = 0 -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'interactive_coll_list' -%}
                          {%- assign counter = counter | plus: 1 -%}
                          {%- unless counter == 1 -%}
                            /
                          {%- endunless -%}
                          <button
                            type="button"
                            class="text-button {% if counter == 1 %} cust-link-active{% endif %}"
                            data-cust-link
                          >
                            {{ block.settings.title }}
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="cust-ic-list-swiper-wrapper">
                    <div class="swiper swiper-{{ section.id }} cust-ic-list-swiper">
                      <div class="swiper-wrapper">
                        {%- for block in section.blocks -%}
                          {%- if block.type == 'interactive_coll_list' -%}
                            <a
                              href="{{ block.settings.collection.url }}"
                              class="swiper-slide"
                              style="pointer-events: auto;"
                              {{ block.shopify_attributes }}
                            >
                              {%- assign image = block.settings.collection_thumbnail -%}
                              {%- if image -%}
                                {{ image | image_url: width: 1200 | image_tag }}
                              {%- endif -%}
                              <div class="cust-ic-list-card-content">
                                <div class="h5">
                                  {{ block.settings.title }}
                                </div>
                                <div
                                  style="font-size: 13px;"
                                >
                                  {{ block.settings.description }}
                                </div>
                                <div
                                  class="text-button"
                                >
                                  {{- block.settings.cta -}}
                                </div>
                              </div>
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- when 'image' -%}
                <div class="image-with-text__content__image" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {% assign image = block.settings.image %}
                    {% assign master_width = image.src.width | append: 'x' | append: image.src.height %}
                    {%- render 'responsive-image', image: image, sizes: master_width, retina: block.settings.retina -%}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder_svg_tag' }}
                  {%- endif -%}
                </div>
              {%- when 'subheading' -%}
                <p class="subheading" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- when 'heading' -%}
                <h2 class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text | newline_to_br }}
                </h2>
              {%- when 'text' -%}
                <div class="rte description-size--{{ block.settings.description_size }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- when 'button' -%}
                {% if block.settings.button_text != blank %}
                  <a
                    class="text-button"
                    href="{{ block.settings.button_link }}"
                    title="{{ block.settings.button_text | escape }}"
                    {{ block.shopify_attributes }}
                    ><span>{{ block.settings.button_text }}</span></a
                  >
                {% endif %}
              {% when 'space' %}
                <div style="height: {{ block.settings.height | append: 'px' }}" {{ block.shopify_attributes }}></div>
              {% when 'collapsible_tab' %}
                <collapsible-row class="accordion" {{ block.shopify_attributes }}>
                  <details
                    id="Details-{{ block.id }}-{{ section.id }}"
                    {% if block.settings.open %}
                      open
                    {% endif %}
                  >
                    <summary>
                      {{ block.settings.heading | default: block.settings.page.title }}
                      <span></span>
                    </summary>
                    <div
                      class="collapsible__content accordion__content rte"
                      id="Accordion-{{ block.id }}-{{ section.id }}"
                    >
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </collapsible-row>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
  // DOMContentLoaded event listener, .swiper-{{ section.id }} and init:
  document.addEventListener('DOMContentLoaded', function () {
    const custLinks = document.querySelectorAll(
      '.cust-image-with-text-interactive-collection-list-{{ section.id }} [data-cust-link]'
    );

    const swiper = new Swiper('.swiper-{{ section.id }}', {
      slidesPerView: 1,
      effect: 'flip',
      allowTouchMove: false,
      autoHeight: true,
    });

    const swiperImages = new Swiper('.swiper-images-{{ section.id }}', {
      slidesPerView: 1,
      autoHeight: true,
    });

    // use the curtLink to change the both slides:
    custLinks.forEach((link, index) => {
      link.addEventListener('click', () => {
        swiper.slideTo(index);
        swiperImages.slideTo(index);
        custLinks.forEach((link) => link.classList.remove('cust-link-active'));
        link.classList.add('cust-link-active');
      });
    });

    function updateLink() {}
    function updateMedia() {}

    updateLink();
    updateMedia();
  });
</script>

