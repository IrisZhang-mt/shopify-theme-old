{{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}
<style>
  #shopify-section-{{section.id}} .section_OurStory3All{
      margin-top: {{section.settings.Desktop_top}}px;
      margin-bottom: {{section.settings.Desktop_bottom}}px;

      padding-top:{{section.settings.Desktop_paddingTop}}px;
      padding-bottom:{{section.settings.Desktop_paddingBottom}}px;
  }
  @media(max-width:999px) {
      #shopify-section-{{section.id}} .section_OurStory3All{
          margin-top: {{section.settings.Mobile_top}}px;
          margin-bottom: {{section.settings.Mobile_bottom}}px;

          padding-top:{{section.settings.Mobile_paddingTop}}px;
          padding-bottom:{{section.settings.Mobile_paddingBottom}}px;
      }
  }
   #shopify-section-{{section.id}} .section_OurStory3_Box {
    background-color: {{section.settings.bg_color}};
  }
  .section_OurStory3_Box img {
      width: 100%;
  }
  .section_OurStory3All .container {
    max-width: 1590px;
    margin: 0 auto;
  }
  .section_OurStory3_BoxPosition_text p:last-child {
    margin-bottom: 0;
  }
  .section_OurStory3_BoxPosition_title {
    margin: 0;
  }
  .section_OurStory3All .swiper-scrollbar {
    border-radius: 10px;
  }
  .section_OurStory3All .swiper-scrollbar-drag {
      background-color: #000;
  }
  @media (min-width: 1000px) {
    .section_OurStory3All .container {
      padding: 0 30px;
    }
    .section_OurStory3All .swiper-wrapper {
      flex-direction: column;
      transform: unset !important;
    }
    .section_OurStory3_box {
      border-radius: 16px;
      overflow: hidden;
    }
    .section_OurStory3_Box {
      display: flex !important;
    }
    .section_OurStory3_Box:nth-child(even) {
      flex-direction: row-reverse;
    }
    .section_OurStory3_BoxLeft {
      width: 50%;
      padding: 40px;
    }
    .section_OurStory3_BoxLeftBox {
      display: flex;
      margin: 0 auto;

      height: 100%;
      max-width: 576px;
      flex-direction: column;
      justify-content: center;
    }
    .section_OurStory3_BoxRight {
      width: 50%;
      overflow: hidden;
    }
    .section_OurStory3All .swiper-scrollbar {
      display: none;
    }
    .section_OurStory3_BoxPosition_title {
      font-size: 34px;
      font-weight: 500;
    }
    .section_OurStory3_BoxPosition_text {
      margin-top: 30px;
    }
    .section_OurStory3_BoxRight img {
        transition: transform 0.5s ease;
        transform: translateZ(0);
    }
    .section_OurStory3_BoxRight:hover img {
        transform: scale(1.03);
    }
  }
  @media (max-width: 999px) {
    .section_OurStory3All .container {
      padding: 0 15px;
    }
    .section_OurStory3_Box {
        display: flex !important;
        flex-direction: column-reverse;
        border-radius: 6px;
        overflow: hidden;
    }
    .section_OurStory3_BoxLeftBox {
      padding: 38px 23px;
    }
     .section_OurStory3All .swiper-scrollbar {
        max-width: 300px;
        margin: 0 auto;
        height: 2px !important;
        background-color: #f0f0f0;
        position: static !important;
        margin-top: 16px;
    }
    .section_OurStory3_BoxRight {
      position: relative;
    }
    .section_OurStory3_BoxPosition_title {
      font-size: 22px;
      font-weight: 500;
      position: absolute;
      color: #fff;
      bottom: 0;
      left: 0;
      padding: 20px;
    }
    .section_OurStory3_BoxPosition_text {
      font-size: 12px;
    }
  }
</style>

<div class="section_OurStory3All">
  <div class="container">
    <div class="section_OurStory3_box">
      <div class="section_OurStory3Swiper swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="section_OurStory3_Box swiper-slide">
              <div class="section_OurStory3_BoxLeft">
                <div class="section_OurStory3_BoxLeftBox">
                  {% if block.settings.title != blank %}
                    <h3 class="section_OurStory3_BoxPosition_title pad_pc">
                      {{ block.settings.title }}
                    </h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="section_OurStory3_BoxPosition_text">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="section_OurStory3_BoxRight">
                <img
                  loading="lazy"
                  src="{{ block.settings.img | img_url:'master' }}"
                  alt="{{ block.settings.img.alt }}"
                  class="pad_pc"
                >
                <img
                  loading="lazy"
                  src="{{ block.settings.img_mobile | img_url:'master' }}"
                  alt="{{ block.settings.img_mobile.alt }}"
                  class="pad_mobile"
                >
                {% if block.settings.title != blank %}
                    <h3 class="section_OurStory3_BoxPosition_title pad_mobile">
                      {{ block.settings.title }}
                    </h3>
                  {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-scrollbar"></div>
      </div>
    </div>
  </div>
</div>
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script>
  document.addEventListener( 'DOMContentLoaded', function () {
    var swiper = new Swiper(`#shopify-section-{{section.id}} .section_OurStory3Swiper`, {
      observer: true,
      observeParents: true,
      slidesPerView: 1,
      spaceBetween: 10,
      scrollbar: {
        el: '#shopify-section-{{section.id}} .section_OurStory3Swiper .swiper-scrollbar',
      },
      navigation: {
        nextEl: `#shopify-section-{{section.id}} .section_OurStory3Swiper .swiper-button-next`,
        prevEl: `#shopify-section-{{section.id}} .section_OurStory3Swiper .swiper-button-prev`,
      },
    });
  })
</script>
{% schema %}
{
  "name": "Section Our Story3",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "background color",
      "default": "#fafafa"
    },
    {
      "type": "header",
      "content": "Spacing Top:"
    },
    {
      "type": "number",
      "id": "Desktop_top",
      "label": "Desktop Margin Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_top",
      "label": "Mobile Margin Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "Desktop_paddingTop",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_paddingTop",
      "label": "Mobile Padding Top",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing Bottom:"
    },
    {
      "type": "number",
      "id": "Desktop_bottom",
      "label": "Desktop Margin Bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_bottom",
      "label": "Mobile Margin Bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "Desktop_paddingBottom",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_paddingBottom",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "img"
        },
         {
          "type": "image_picker",
          "id": "img_mobile",
          "label": "img mobile"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Section Our Story3"
    }
  ]
}
{% endschema %}
