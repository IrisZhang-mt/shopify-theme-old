			display: flex;
			margin-top: 72px;
			justify-content: center;
			margin-bottom: 54px;
		}
		.account_customerBox{
			min-height: 100vh;
			display: flex;
			gap: 128px;
		}
		.account_customerLeft{
			padding-left: 40px;
			background: #FDF6EE;
			width: 30.2%;
			max-width: 580px;
		}
		.account_customerRight{
			width: 69.8%;
		}
		.account_customerRight .account_customerRight_box{
			padding-top: 185px;
		}
 
		.account_detailsTop,.account_ordersTop {
			padding-bottom: 32px;
			margin-bottom: 42px;
			border-bottom: 1px solid #FF8300;
		}
		.account_detailsBox{
			display: flex;
			gap: 35px;
			align-items: center;
			justify-content: space-between;
		}
		.account_detailsBox_Isleft{
			display: flex;
			gap: 16px;
			align-items: center; 
		}
		.account_detailsBox:not(:first-child){
			margin-top: 36px;
		}
		.account_detailsBox_left{
			color: #FF8300;
			font-weight: 500;
			width: min-content;
			display: block;
			min-width: max-content;
		}
		.account_detailsBox_right{
			color: #333;
		}
		.account_customerRight_box {
			max-width: 960px;
		}
		.account_detailsBox_IsRight {
			display: flex;
			align-items: center;
		}
		/* order */

		.rowgroup>div{
			color: #FF8300;
			font-size: 20px;
			line-height: 1;
			font-weight: 600;
		}
		.account_ordersBottom .rowgroup{
			margin-bottom: 32px;
		}
		.rowgroup,.rowgroup_bottom .row_text{
			display: flex;
			gap: 34px;
			margin-bottom: 24px;
			align-items: center;
		}
		.rowgroup_1,.rowgroupContent_1{
			width: 150px;
		}
		.rowgroup_2,.rowgroupContent_2{
			width: 210px;
		}
		.rowgroup_3,.rowgroupContent_3{
			width: 250px;
		}
		.rowgroup_4,.rowgroupContent_4{
			width: 250px;
		}
		.rowgroup_5,.rowgroupContent_5{
			width: auto;
			min-width: 65px;
		}
		.row_text{
			font-size: 16px;
			color: #000;
		}
		.rowgroupContent_1 a{
			color: #FF8300;
		}
		/*  */
		.my_h_title{
		font-weight: 600;
		font-size: 36px;
		}
		.account_customerRight_box{
		display: none;
		}
		.account_customerRight_box.active{
		display: block;
		}
	}
	@media (max-width:999px) {
		.slp_51a39c {
			padding: 0 !important;;
		}
