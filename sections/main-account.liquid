			align-items: center;
			background-color: #fff;
			color: #000 !important;
			text-decoration: unset !important;
		}
		.account_customerMobile_tabBox:not(:first-child){
			margin-top: 16px;
		}
		
		.account_customerRight_boxMobile1,.account_customerRight_boxMobile2,.account_customerRight_boxMobile3{
			display: none;
		}
	
		.account_customerRight_boxMobile{
			padding: 23px 20px;
		}
		.my_h_title{
			font-weight: 600;
		}
	
		.row_text{
			height: 96px;
			display: flex;
			flex-direction: column;
			font-weight: 400;
			padding: 10px 16px;
			background-color: #FDF6EE;
			justify-content: space-between;
		}
		.row_text:not(:first-child){
			margin-top: 16px;
		}
		.row_textTop{
			display: flex;
			gap: 10px;
			align-items: center;
			justify-content: space-between;
		}
		.row_textBottom{
			display: flex;
			gap: 10px;
			align-items: center;
			justify-content: space-between;
		}
		.account_ordersTop {
			width: max-content;
			cursor: pointer; 
			display: flex;
			gap: 8px;
			line-height: 1;
			align-items: center;
			color: #FF8300;
			margin-bottom: 32px;
			font-weight: 600;
		}
		.row_textTop_left a{
			color: #FF8300;
			font-weight: 600;
		}
		.row_textBottom_left {
			font-size: 18px;
			font-weight: 600;
		}
		.row_textTop_right{
			color: #000;
		}
		.row_textBottom_right {
		
		}
		.row_textBottom_right>div{
			line-height: 1;
		}
		.yotpo-widget-my-rewards-widget .yotpo-is-mobile .yotpo-action-buttons-tile{
			gap: 10px !important;
		}

		.account_customerMobile_right{
			width: 100%;
			gap: 5px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.account_customerMobile_rightBox{
			width: auto;
		}
		.account_detailsBox_IsRight{
			display: flex;
			justify-content: flex-end;
			min-width: 30px;
			align-items: flex-end;
		}
		.account_detailsBox_IsRight svg{
			width: 16px;
			height: auto;
		}
	}
