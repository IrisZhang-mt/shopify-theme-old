			color: #FF8300 !important;
			font-weight: 600;
			border-color:#FF8300;
		}
		.account_customerLeft_bottomBox svg{
			width:36px;
			height:auto;
		}
		.account_customerLeft_bottomBox.active svg path{
			fill:#FF8300;
		}
		.accountCustomerLeft_bottomBox_left{
			display: flex;
		}
		.account_customerLeftBox {
			max-width: 383px;
			margin-left: auto;
		}
