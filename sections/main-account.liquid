						<g clip-path="url(#clip0_14_314)">
						<path d="M12.033 0V2.25H3C2.80109 2.25 2.61032 2.32902 2.46967 2.46967C2.32902 2.61032 2.25 2.80109 2.25 3V21C2.25 21.1989 2.32902 21.3897 2.46967 21.5303C2.61032 21.671 2.80109 21.75 3 21.75H21C21.1989 21.75 21.3897 21.671 21.5303 21.5303C21.671 21.3897 21.75 21.1989 21.75 21V12.186H24V21C24 21.7956 23.6839 22.5587 23.1213 23.1213C22.5587 23.6839 21.7956 24 21 24H3C2.20435 24 1.44129 23.6839 0.87868 23.1213C0.316071 22.5587 0 21.7956 0 21V3C0 2.20435 0.316071 1.44129 0.87868 0.87868C1.44129 0.316071 2.20435 0 3 0L12.033 0Z" fill="#FF8300"/>
						<path d="M21.9255 0.797974L23.559 2.34597L9.738 16.926L8.1045 15.3795L21.9255 0.797974Z" fill="#FF8300"/>
						</g>
						<defs>
						<clipPath id="clip0_14_314">
							<rect width="24" height="24" fill="white"/>
						</clipPath>
						</defs>
					</svg>
                  </a>
                </div>
              </div>
          </div>
      </div>

      <div class="account_customerRight_box account_customerRight_box2 account_customerRight_boxMobile account_customerRight_boxMobile1">
        <div class="account_ordersBox my_m_14">
          <h2 class="account_ordersTop my_h_title pad_pc">{{ 'customer.orders.title' | t }}</h2>
          <h2 class="account_ordersTop my_h_title pad_mobile my_m_14">< &nbsp {{ 'customer.orders.title' | t }}</h2>

          <div class="account_ordersBottom ">
            {% paginate customer.orders by 20 %}
              {%- if customer.orders.size > 0 -%}
                <div class="pad_pc">
                  <div role="table" class="order-history">
                    <div class="rowgroup">
                      <div id="ColumnOrder" class="rowgroup_1" scope="col" role="columnheader">{{ 'customer.orders.order_number' | t }}</div>
                      <div id="ColumnDate" class="rowgroup_2" scope="col" role="columnheader">{{ 'customer.orders.date' | t }}</div>
                      <div id="ColumnPayment" class="rowgroup_3" scope="col" role="columnheader">{{ 'customer.orders.payment_status' | t }}</div>
                      <div id="ColumnFulfillment" class="rowgroup_4" scope="col" role="columnheader">
                        {{ 'customer.orders.fulfillment_status' | t }}
                      </div>
                      <div id="ColumnTotal" class="rowgroup_5"  scope="col" role="columnheader">{{ 'customer.orders.total' | t }}</div>
                    </div>
                    <div role="rowgroup" class="rowgroup_bottom">
                      {%- for order in customer.orders -%}
                        <div role="row" class="row_text">
                          <div
                            id="RowOrder"
                            class="rowgroupContent_1"
                            role="cell"
                            headers="ColumnOrder"
                            data-label="{{ 'customer.orders.order_number' | t }}"
                          >
 
                            <a
                              href="{{ order.customer_url }}"
                              aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                            >
                            {{ order.name }}
                          </a> 
                          </div>
                          <div headers="RowOrder ColumnDate" role="cell" class="rowgroupContent_2"  data-label="{{ 'customer.orders.date' | t }}">
                            {{ order.created_at | time_tag: format: 'date' }}
                          </div>
                          <div
                            headers="RowOrder ColumnPayment"
                            role="cell"
                            class="rowgroupContent_3"
                            data-label="{{ 'customer.orders.payment_status' | t }}"
                          >
                            {{ order.financial_status_label }}
                          </div>
                          <div
                            headers="RowOrder ColumnFulfillment"
                            role="cell"
                            class="rowgroupContent_4"
                            data-label="{{ 'customer.orders.fulfillment_status' | t }}"
                          >
                            {{ order.fulfillment_status_label }}
                          </div>
                          <div headers="RowOrder ColumnTotal" class="rowgroupContent_5" role="cell" data-label="{{ 'customer.orders.total' | t }}">
                            {{ order.total_net_amount | money_with_currency }}
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
                <div class="pad_mobile">
                    <div class="row_textBox">
                      {%- for order in customer.orders -%}
                        <div role="row" class="row_text">
                          <div class="row_textTop">
                              <div class="row_textTop_left my_m_14">
                                <a
                                  href="{{ order.customer_url }}"
                                  aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                                >
                                {{ order.name }}
                              </a> 
                              </div>
                              <div class="row_textTop_right my_m_14">
                                {{ order.created_at | time_tag: format: 'date' }}
                              </div>
                          </div>
                          <div class="row_textBottom">
     
                              <div class="row_textBottom_right my_m_12">
                                  <div>
									{{ order.financial_status_label }}
                                    {{ order.fulfillment_status_label }} 
                                  </div>
                       
                              </div>
							  <div class="row_textBottom_left my_m_20">
                                {{ order.total_net_amount | money_with_currency }}
                              </div>
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                </div>
              {%- else -%}
                <p class="my_h_16 my_m_14">{{ 'customer.orders.none' | t }}</p>
              {%- endif -%}
  
              {%- if paginate.pages > 1 -%}
                {%- if paginate.parts.size > 0 -%}
                  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                    <ul role="list">
                      {%- if paginate.previous -%}
                        <li>
                          <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                            <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                            </svg>
                          </a>
                        </li>
                      {%- endif -%}
  
                      {%- for part in paginate.parts -%}
                        <li>
                          {%- if part.is_link -%}
                            <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                              {{- part.title -}}
                            </a>
                          {%- else -%}
                            {%- if part.title == paginate.current_page -%}
                              <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                                {{- part.title -}}
                              </span>
                            {%- else -%}
                              <span>{{ part.title }}</span>
                            {%- endif -%}
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
  
                      {%- if paginate.next -%}
                        <li>
                          <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                            <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                              <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                            </svg>
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  </nav>
                {%- endif -%}
              {%- endif -%}
            {% endpaginate %}
          </div>
        </div>

      </div>

	  	{% for block in section.blocks %}	
			{% if block.type == '@app' %}
				{% if forloop.index0 == 0%}
					<div class="account_customerRight_box account_customerRight_box3 account_customerRight_boxMobile account_customerRight_boxMobile2">
						<h2 class="account_ordersTop my_h_title pad_pc">{{section.settings.my_points}}</h2>
						<h2 class="account_ordersTop my_h_title pad_mobile my_m_14">< &nbsp {{section.settings.my_points}}</h2>
						{% render block %}
					</div>
				{% endif %}
				{% if forloop.index0 == 1 %}
					<div class="account_customerRight_box account_customerRight_box4 account_customerRight_boxMobile account_customerRight_boxMobile3">
						<h2 class="account_ordersTop my_h_title pad_pc">{{section.settings.refer_friend}}</h2>
						<h2 class="account_ordersTop my_h_title pad_mobile my_m_14">< &nbsp {{section.settings.refer_friend}}</h2>
						{% render block %}
					</div>
				{% endif %}
	  		{% endif %}
		{% endfor %}

    </div>
  </div>
</div> 
<script>
	document.querySelectorAll(".account_customerLeft_bottomBox").forEach(function(element, index) {
		element.addEventListener("click", function() {
			document.documentElement.scrollTop = 0; // 滚动到页面顶部
			document.body.scrollTop = 0;
			
			document.querySelectorAll(".account_customerLeft_bottomBox").forEach(function(el) {
				el.classList.remove("active");
			});
			element.classList.add("active");
			
			document.querySelectorAll(".account_customerRight_box").forEach(function(el) {
				el.classList.remove("active");
			});
			document.querySelectorAll(".account_customerRight_box")[index].classList.add("active");
		});
	});

	document.querySelectorAll(".account_customerMobile_tabBox").forEach(function(element, index) {
		element.addEventListener("click", function() {
			document.querySelector(".account_customerMobileBox").style.display = "none";
			var mobileBox = document.querySelector(".account_customerRight_boxMobile" + (index + 1));
			if (mobileBox) {
				mobileBox.style.display = "block";
			}
			document.querySelectorAll(".account_customerRight_boxMobile").forEach(function(el) {
				if (el !== mobileBox) {
					el.style.display = "none";
				}
			});
		});
	});

	document.querySelectorAll(".account_ordersTop").forEach(function(element) {
		element.addEventListener("click", function() {
			document.querySelector(".account_customerMobileBox").style.display = "block";
			var parentBox = element.closest(".account_customerRight_boxMobile");
			if (parentBox) {
				parentBox.style.display = "none";
			}
		});
	});
</script> 
{% schema %} 
{ 
  "name": "main account",  
  "settings": [
	{
		"type": "text",
		"id": "my_points",
		"label": "My Points",
		"default": "My Points"
	},
	{
		"type": "text",
		"id": "refer_friend",
		"label": "Refer a friend",
		"default": "Refer a friend"
	}
  ],
  "blocks": [
    {
      "type": "@app"
    }
]
}
{% endschema %}
