{%- liquid
  assign section_heading = section.settings.heading
  assign section_heading_left = section.settings.heading_left
  assign section_description = section.settings.description
  assign full_width = section.settings.full_width
  assign columns_desktop = section.settings.columns_desktop
  assign section_blog = section.settings.blog
  assign post_limit = section.settings.post_limit
  assign show_view_all = section.settings.show_view_all
  assign show_date = section.settings.show_date
  assign show_excerpt = section.settings.show_excerpt
  assign image_ratio = section.settings.image_ratio
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign columns_class = 'medium-6 large-4'

  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity

  case columns_desktop
    when 2
      assign columns_class = 'medium-6'
    when 3
      assign columns_class = 'medium-4'
    when 4
      assign columns_class = 'medium-6 large-3'
  endcase

  if section_blog != blank and show_view_all and post_limit < section_blog.articles_count
    assign section_heading_button_blog = section_blog
  endif
-%}
<div class="row{% if full_width %} full-width-row{% endif %} cust-blog-post-section">
  <div class="small-12 columns">
    <div
      class="
        section-spacing
        {% if disable_top_spacing %} section-spacing--disable-top{% endif %}
        {% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}
      "
    >
      {% render 'section-header',
        section_heading: section_heading,
        section_description: section_description,
        section_heading_left: section_heading_left,
        section_heading_button_blog: section_heading_button_blog
      %}
      <div
        class="gallery gallery-spacing--small"
        style="
          --gallery-columns: {{ columns_desktop }};
          --overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }};
          --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
          --cbp-bg-color: {{ section.settings.card_bg }};
        "
      >
        <slide-show
          data-id="{{ section.id }}"
          id="gallery-{{ section.id }}"
          class="products carousel small-up-2 medium-up-{{ columns_desktop }}"
        >
          {% if section_blog and blogs[section_blog].articles.size > 0 %}
            {% for article in blogs[section_blog].articles limit: post_limit %}
              <div
                class="{{ columns_class }} gallery__item carousel__slide "
              >
                {% render 'cust_blog-post',
                  article: article,
                  show_date: show_date,
                  show_excerpt: show_excerpt,
                  image_ratio: image_ratio
                %}
              </div>
            {% endfor %}
          {% else %}
            {% assign placeholder_array = '1,2,3,4,5,6' | split: ',' %}
            {% for item in placeholder_array limit: post_limit %}
              <div
                class="{{ columns_class }} gallery__item carousel__slide "
              >
                {% render 'cust_blog-post',
                  article: false,
                  show_date: show_date,
                  show_excerpt: show_excerpt,
                  image_ratio: image_ratio
                %}
              </div>
            {% endfor %}
          {% endif %}
          {%- if section_blog != blank and show_view_all -%}
            <div
              class="{{ columns_class }} gallery__item carousel__slide "
            >
              {% render 'cust_blog-post',
                title: section.settings.view_all_title,
                text: section.settings.view_all_text,
                view_all_url: section_blog.url
              -%}
            </div>
          {%- endif -%}
          {%- render 'slideshow-arrows' -%}
        </slide-show>
      </div>
    </div>
  </div>
</div>
{{ 'blog.css' | asset_url | stylesheet_tag }}
{% comment %} We need the gallery.css since there are styles coming from it {% endcomment %}
{{- 'gallery.css' | asset_url | stylesheet_tag -}}
{% schema %}
{
  "name": "Cust blog posts overlay",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest News"
    },
    {
      "type": "checkbox",
      "id": "heading_left",
      "default": false,
      "label": "Left align heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Add a short description for your brand news</p>"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of blog posts to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "Show date"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": true,
      "label": "Show excerpt"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Enable \"View all\" button if blog includes more blog posts than shown"
    },
    {
      "type": "text",
      "id": "view_all_title",
      "label": "View all title",
      "default": "All News"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_top_spacing",
      "default": false,
      "label": "Remove top spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_bottom_spacing",
      "default": false,
      "label": "Remove bottom spacing"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 50
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#fbf6ef"
    }
  ],
  "presets": [
    {
      "name": "Cust blog posts overlay"
    }
  ]
}
{% endschema %}
