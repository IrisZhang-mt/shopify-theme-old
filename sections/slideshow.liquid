{{- 'slideshow.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height
  assign desktop_custom_height = section.settings.desktop_custom_height | default: 650
  assign mobile_custom_height = section.settings.mobile_custom_height | default: 500
  assign full_width = section.settings.full_width
  assign transition = section.settings.transition
  assign autoplay = section.settings.autoplay
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign desktop_content_left_spacing = section.settings.desktop_content_left_spacing | default: 48
  assign desktop_content_bottom_spacing = section.settings.desktop_content_bottom_spacing | default: 91
  assign mobile_content_left_spacing = section.settings.mobile_content_left_spacing | default: 12
  assign mobile_content_bottom_spacing = section.settings.mobile_content_bottom_spacing | default: 99
  assign button_font_size = section.settings.button_font_size | default: 16
  assign button_padding_vertical = section.settings.button_padding_vertical | default: 19
  assign button_padding_horizontal = section.settings.button_padding_horizontal | default: 28
  assign dots = true
  if section.blocks.size < 2
    assign dots = false
  endif

  if autoplay
    assign autoplay = section.settings.autoplay_length | times: 1000
  endif

  case mobile_height
    when 'mobile-height-400'
      assign mobile_image_height = 400
    when 'mobile-height-450'
      assign mobile_image_height = 450
    when 'mobile-height-500'
      assign mobile_image_height = 500
    when 'mobile-height-custom'
      assign mobile_image_height = mobile_custom_height
    else
      assign mobile_image_height = 500
  endcase

  assign fade = true
  if transition == 'slide'
    assign fade = false
  endif

  assign preload = false

  if section.index == 1
    assign preload = true
  endif
-%}
<div class="row{% if full_width %} full-width-row{% endif %}">
  <div class="small-12 columns">
    <slide-show
      class="slideshow main-slideshow carousel custom-dots {{ mobile_height }} {{ desktop_height }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %} transition--{{ transition }}"
      data-dots="{{ dots }}"
      data-autoplay="{{ autoplay }}"
      data-fade="{{ fade }}"
      data-transition="{{ transition }}"
      style="--dot-speed: {{ autoplay | divided_by: 1000 | append: 's' }}; --color-text: #fff; --slideshow-desktop-height: {{ desktop_custom_height }}px; --slideshow-mobile-height: {{ mobile_custom_height }}px; --slideshow-desktop-content-left-spacing: {{ desktop_content_left_spacing }}px; --slideshow-desktop-content-bottom-spacing: {{ desktop_content_bottom_spacing }}px; --slideshow-mobile-content-left-spacing: {{ mobile_content_left_spacing }}px; --slideshow-mobile-content-bottom-spacing: {{ mobile_content_bottom_spacing }}px; --slideshow-button-font-size: {{ button_font_size }}px; --slideshow-button-padding-vertical: {{ button_padding_vertical }}px; --slideshow-button-padding-horizontal: {{ button_padding_horizontal }}px;"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign content_position = block.settings.content_position
          assign text_alignment = block.settings.text_alignment
          assign mobile_content_position = block.settings.mobile_content_position | default: content_position
          assign mobile_text_alignment = block.settings.mobile_text_alignment | default: text_alignment
          assign content_size = block.settings.content_size
          assign overlay_color = block.settings.overlay_color
          assign overlay_opacity = block.settings.overlay_opacity
          assign heading_size = block.settings.heading_size | default: 70
          assign description_size = block.settings.description_size | default: 24
          assign mobile_heading_size = block.settings.mobile_heading_size | default: heading_size
          assign mobile_description_size = block.settings.mobile_description_size | default: description_size
          assign custom_desktop_text_spacing = block.settings.custom_desktop_text_spacing
          assign custom_mobile_text_spacing = block.settings.custom_mobile_text_spacing
          assign desktop_heading_description_spacing = block.settings.desktop_heading_description_spacing | default: 0
          assign desktop_description_button_spacing = block.settings.desktop_description_button_spacing | default: 0
          assign mobile_heading_description_spacing = block.settings.mobile_heading_description_spacing | default: 0
          assign mobile_description_button_spacing = block.settings.mobile_description_button_spacing | default: 0
          assign text_spacing_classes = ''
          assign priority = false

          if mobile_content_position == 'same'
            assign mobile_content_position = content_position
          endif

          if mobile_text_alignment == 'same'
            assign mobile_text_alignment = text_alignment
          endif

          if mobile_heading_size == 0
            assign mobile_heading_size = heading_size
          endif

          if mobile_description_size == 0
            assign mobile_description_size = description_size
          endif

          if custom_desktop_text_spacing
            assign text_spacing_classes = text_spacing_classes | append: ' custom-desktop-text-spacing'
          endif

          if custom_mobile_text_spacing
            assign text_spacing_classes = text_spacing_classes | append: ' custom-mobile-text-spacing'
          endif

          if forloop.index == 1 and preload
            assign priority = 'high'
          endif
        -%}
        <div
          class="slideshow__slide carousel__slide {{ mobile_height }} {{ desktop_height }} text-{{ text_alignment }} mobile-text-{{ mobile_text_alignment }} content-size-{{ content_size }}{{ text_spacing_classes }}{% if forloop.index == 1 %} is-initial-selected{% endif -%}"
          style="--overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }}; --slideshow-heading-size: {{ heading_size }}px; --slideshow-description-size: {{ description_size }}px; --slideshow-mobile-heading-size: {{ mobile_heading_size }}px; --slideshow-mobile-description-size: {{ mobile_description_size }}px; --slideshow-heading-description-spacing: {{ desktop_heading_description_spacing }}px; --slideshow-description-button-spacing: {{ desktop_description_button_spacing }}px; --slideshow-mobile-heading-description-spacing: {{ mobile_heading_description_spacing }}px; --slideshow-mobile-description-button-spacing: {{ mobile_description_button_spacing }}px;"
          data-mt-impress="view_promotion"
          data-mt-label="{{ block.settings.heading | default: block.settings.subheading | strip_html | escape }}"
          data-mt-params='{"slide":{{ forloop.index }},"section":"slideshow"}'
          {{ block.shopify_attributes }}
        >
          {%- if desktop_height == 'desktop-height-image' or mobile_height == 'mobile-height-image' -%}
            <div class="slideshow__slide-adapt-to-image">
              {%- if block.settings.image -%}
                {%- liquid
                  assign image = block.settings.image
                  assign master_width = image.src.width | append: 'x' | append: image.src.height
                  assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width

                  assign class = ''
                  if block.settings.mobile_image
                    assign class = 'slideshow-image--desktop'
                  endif
                -%}
                {%- comment -%} 性能优化(LCP)：本层 opacity:0，仅用于按图片宽高比撑出 slide 高度，不可见。改为加载 20px 占位图（原为全尺寸原图，移动端 display:none 仍会下载 1MB+），宽高比由 width/height 属性保证，布局不变。{%- endcomment -%}
                <img
                  data-src="{{ image | image_url: width: 20 }}"
                  class="lazyload {{ class }}{% unless settings.lazy_loading %} no-blur{% endunless %}"
                  width="{{ image.src.width }}"
                  height="{{ image.src.height }}"
                  alt="{{ image.alt }}"
                >
              {%- else -%}
                {%- assign index = forloop.index | modulo: 2 | plus: 1 -%}
                {{ 'lifestyle-' | append: index | placeholder_svg_tag: 'placeholder_svg_tag' }}
              {%- endif -%}
              {%- if block.settings.mobile_image -%}
                {%- liquid
                  assign image = block.settings.mobile_image
                  assign master_width = image.src.width | append: 'x' | append: image.src.height
                  assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width
                -%}
                <img
                  data-src="{{ image | image_url: width: 20 }}"
                  class="lazyload slideshow-image--mobile{% unless settings.lazy_loading %} no-blur{% endunless %}"
                  width="{{ image.src.width }}"
                  height="{{ image.src.height }}"
                  alt="{{ image.alt }}"
                >
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="slideshow__slide-bg">
            {%- if block.settings.image -%}
              {%- liquid
                assign image = block.settings.image
                assign master_width = image.src.width | append: 'x' | append: image.src.height
                assign variable_widths = '900x,1000x,1100x,1200x,1400x,1600x,' | append: master_width
                assign width = '375x' | append: mobile_image_height | append: ',' | append: variable_widths
                assign class = null

                if block.settings.mobile_image != blank
                  assign class = 'slideshow-image--desktop'
                  assign width = variable_widths
                endif
              -%}
              {%- comment -%} eager: priority —— 首屏首图(priority=='high')绕过懒加载立即渲染，修复 LCP；其余幻灯片 priority=false 保持懒加载。 {%- endcomment -%}
              {%- render 'responsive-image',
                image: image,
                sizes: width,
                class: class,
                priority: priority,
                eager: priority
              -%}
            {%- else -%}
              {%- assign index = forloop.index | modulo: 2 | plus: 1 -%}
              {{ 'lifestyle-' | append: index | placeholder_svg_tag: 'placeholder_svg_tag' }}
            {%- endif -%}
            {%- if block.settings.mobile_image != blank -%}
              {%- liquid
                assign image = block.settings.mobile_image
                assign master_width = image.src.width | append: 'x' | append: image.src.height
                assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width
              -%}
              {%- render 'responsive-image',
                image: image,
                sizes: width,
                class: 'slideshow-image--mobile',
                priority: priority,
                eager: priority
              -%}
            {%- endif -%}
          </div>
          {%- if block.settings.video_background -%}
            {%- if block.settings.video_hosted != blank -%}
              {%- liquid
                assign video = block.settings.video_hosted
                assign autoplay = true
              -%}
              {% comment %}
                if forloop.index == 1
                	assign autoplay = true
                endif
              {% endcomment %}
              {%- comment -%} 性能优化(视频延迟加载)：原用 video_tag 且 autoplay=true，<video> 一进 DOM 就立即下载
                  HD-1080p 4.8Mbps 视频，是首屏 ~14MB 负载的大头。改为：去掉 autoplay、preload="none"、
                  source 改用 data-src，首屏只显示 poster（秒出、不抢带宽）；页面 load+空闲后由 slideshow.js 激活并播放。
                  另修复原 class 拼写 slideshow-image--desk→--desktop：原拼写在 CSS 里无隐藏规则，导致移动端也会下载桌面视频（双份）。{%- endcomment -%}
              <div
                class="slideshow__slide-video-bg  slideshow-image--desktop"
                data-provider="hosted"
                data-video-id="{{ video.id }}"
              >
                <video class="slideshow__video" muted loop playsinline preload="none" poster="{{ video.preview_image | image_url: width: 1600 }}">
                  {%- for source in video.sources -%}
                    {%- if source.mime_type == 'video/mp4' -%}
                      <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
              </div>
              {%- assign video_m = block.settings.video_hosted_m -%}
              {%- if video_m == blank -%}{%- assign video_m = video -%}{%- endif -%}
              <div
                class="slideshow__slide-video-bg  slideshow-image--mobile"
                data-provider="hosted"
                data-video-id="{{ video_m.id }}"
              >
                <video class="slideshow__video" muted loop playsinline preload="none" poster="{{ video_m.preview_image | image_url: width: 1600 }}">
                  {%- for source in video_m.sources -%}
                    {%- if source.mime_type == 'video/mp4' -%}
                      <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
              </div>
            {%- elsif block.settings.video != blank -%}
              {%- liquid
                assign video = block.settings.video
                assign src_type = 'data-src'
                if forloop.index == 1
                  assign src_type = 'src'
                endif
              -%}
              <div class="slideshow__slide-video-bg" data-provider="{{ video.type }}" data-video-id="{{ video.id }}">
                {%- if video.type == 'youtube' -%}
                  <iframe
                    {{ src_type }}="https://www.youtube.com/embed/{{ video.id }}?loop=1&autoplay=1&mute=1&playlist={{ video.id }}&iv_load_policy=3&disablekb=1&controls=0&playsinline=1&enablejsapi=1"
                    frameborder="0"
                    class="lazyload"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    tabindex="-1"
                  ></iframe>
                {%- else -%}
                  <iframe
                    {{ src_type }}="https://player.vimeo.com/video/{{ video.id }}?background=1"
                    frameborder="0"
                    class="lazyload"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    tabindex="-1"
                  ></iframe>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
          <div
            class="slideshow__slide-overlay"
            {% if block.settings.overlay_gradient != blank %}
              style="background: {{ block.settings.overlay_gradient }}"
            {% endif %}
          ></div>
          <div class="slideshow__slide-inner content-{{ content_position }} mobile-content-{{ mobile_content_position }} slideshow_GDF">
            <div class="slideshow__slide-content">
              {% if block.settings.subheading != blank %}
                <p class="subheading" style="color: {{block.settings.subheading_color}};">
                  {{ block.settings.subheading }}
                </p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h1
                  class="split-text slideshow_GDF_h1"
                  style="color: {{ block.settings.heading_color }};"
                >
                  {{ block.settings.heading | newline_to_br }}
                </h1>
              {% endif %}
              {% if block.settings.content != blank %}
                <p
                  class="split-text slideshow_GDF_p"
                  style="color: {{block.settings.content_color}};"
                >
                  {{ block.settings.content | newline_to_br }}
                </p>
              {% endif %}
              {% if block.settings.button_1_text != blank %}
                {%- liquid
                  assign button_1_background = block.settings.button_1_Bgcolor
                  if block.settings.button_1_outline
                    assign button_1_background = 'transparent'
                  endif
                  assign button_hover1_color = block.settings.button_hover1_color | default: block.settings.button_1_color
                  assign button_hover1_background = block.settings.button_hover1_Bgcolor | default: block.settings.button_1_Bgcolor
                -%}
                <div class="button-overflow-container">
                  <a
                    class="button_new button white{% if block.settings.button_1_outline %} outline{%- endif %}"
                    href="{{ block.settings.button_1_link }}"
                    role="button"
                    title="{{ block.settings.button_1_text | escape }}"
                    data-mt-track="select_promotion"
                    data-mt-label="{{ block.settings.button_1_text | escape }}"
                    data-mt-params='{"slide":{{ forloop.index }},"cta":1}'
                    style="border-color: {{ block.settings.button_1_Bgcolor }}; background-color: {{ button_1_background }}; color: {{ block.settings.button_1_color }}; --hover-color: {{ button_hover1_background }}; --hover-text-color: {{ button_hover1_color }};"
                    ><span>{{ block.settings.button_1_text }}</span></a
                  >
                </div>
              {% endif %}
              {% if block.settings.button_2_text != blank %}
                {%- liquid
                  assign button_2_background = block.settings.button_2_Bgcolor
                  if block.settings.button_2_outline
                    assign button_2_background = 'transparent'
                  endif
                  assign button_hover2_color = block.settings.button_hover2_color | default: block.settings.button_2_color
                  assign button_hover2_background = block.settings.button_hover2_Bgcolor | default: block.settings.button_2_Bgcolor
                -%}
                <div class="button-overflow-container">
                  <a
                    class="button_new2 button white{% if block.settings.button_2_outline %} outline{%- endif %}"
                    href="{{ block.settings.button_2_link }}"
                    role="button"
                    title="{{ block.settings.button_2_text | escape }}"
                    data-mt-track="select_promotion"
                    data-mt-label="{{ block.settings.button_2_text | escape }}"
                    data-mt-params='{"slide":{{ forloop.index }},"cta":2}'
                    style="border-color: {{ block.settings.button_2_Bgcolor }}; background-color: {{ button_2_background }}; color: {{ block.settings.button_2_color }}; --hover-color: {{ button_hover2_background }}; --hover-text-color: {{ button_hover2_color }};"
                    ><span>{{ block.settings.button_2_text }}</span></a
                  >
                </div>
              {% endif %}

              <a href="{{ block.settings.slide_link  }}" class="slideshow__slide-content-link" tabindex="-1" data-mt-track="select_promotion" data-mt-label="{{ block.settings.heading | default: block.settings.subheading | strip_html | escape }}" data-mt-params='{"slide":{{ forloop.index }},"cta":"slide"}'></a>
            </div>
          </div>
        </div>
      {%- endfor -%}
      {%- if section.blocks.size > 1 and dots -%}
        <ol class="flickity-page-dots">
          {%- for block in section.blocks -%}
            <li class="dot" aria-label="{{ forloop.index }}">
              {%- render 'svg-icons' with 'thb-pagination-dot' -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </slide-show>
  </div>
</div>

<style>
  .slideshow_GDF .slideshow_GDF_h1{
        font-size: var(--slideshow-heading-size, 32px) !important;
        line-height:normal;
  }
	.slideshow_GDF .slideshow_GDF_p{
        font-size: var(--slideshow-description-size, 20px) !important;
				line-height:normal;
	}

  @media only screen and (max-width: 767px) {
    .slideshow_GDF .slideshow_GDF_h1 {
      font-size: var(--slideshow-mobile-heading-size, var(--slideshow-heading-size, 32px)) !important;
      line-height: normal !important;
    }
    .slideshow_GDF .slideshow_GDF_p {
      font-size: var(--slideshow-mobile-description-size, var(--slideshow-description-size, 20px)) !important;
      line-height: normal !important;
    }
    .slideshow__slide.mobile-text-left {
      text-align: left;
    }
    .slideshow__slide.mobile-text-center {
      text-align: center;
    }
    .slideshow__slide.mobile-text-right {
      text-align: right;
    }
    .slideshow__slide.custom-mobile-text-spacing .slideshow_GDF_h1 + .slideshow_GDF_p {
      margin-top: var(--slideshow-mobile-heading-description-spacing, 0px) !important;
    }
    .slideshow__slide.custom-mobile-text-spacing .slideshow_GDF_p {
      padding: 0 !important;
      margin-bottom: 0 !important;
    }
    .slideshow__slide.custom-mobile-text-spacing .slideshow_GDF_p + .button-overflow-container {
      margin-top: var(--slideshow-mobile-description-button-spacing, 0px) !important;
    }
    .slideshow__slide.custom-mobile-text-spacing .button_new,
    .slideshow__slide.custom-mobile-text-spacing .button_new2 {
      margin-top: 0 !important;
    }
    .slideshow__slide-inner.mobile-content-middle-left {
      justify-content: flex-start;
      align-items: center;
    }
    .slideshow__slide-inner.mobile-content-middle-center {
      justify-content: center;
      align-items: center;
    }
    .slideshow__slide-inner.mobile-content-middle-right {
      justify-content: flex-end;
      align-items: center;
    }
    .slideshow__slide-inner.mobile-content-bottom-left {
      justify-content: flex-start;
      align-items: flex-end;
    }
    .slideshow__slide-inner.mobile-content-bottom-center {
      justify-content: center;
      align-items: flex-end;
    }
    .slideshow__slide-inner.mobile-content-bottom-right {
      justify-content: flex-end;
      align-items: flex-end;
    }
  }

  @media only screen and (min-width: 768px) {
    .slideshow_GDF .slideshow_GDF_h1 {
      line-height:normal !important;
    }
    .slideshow_GDF .slideshow_GDF_p {
      line-height:normal !important;
    }

    .slideshow__slide.custom-desktop-text-spacing .slideshow_GDF_h1 + .slideshow_GDF_p {
      margin-top: var(--slideshow-heading-description-spacing, 0px) !important;
    }
    .slideshow__slide.custom-desktop-text-spacing .slideshow_GDF_p {
      margin-bottom: 0 !important;
    }
    .slideshow__slide.custom-desktop-text-spacing .slideshow_GDF_p + .button-overflow-container {
      margin-top: var(--slideshow-description-button-spacing, 0px) !important;
    }
    .section-slideshow .slideshow__slide.custom-desktop-text-spacing .button_new,
    .section-slideshow .slideshow__slide.custom-desktop-text-spacing .button_new2 {
      margin-top: 0 !important;
    }

    .section-slideshow .slideshow__slide .button_new,
    .section-slideshow .slideshow__slide .button_new2{
      min-width: auto !important;
      min-height: auto !important;
      padding: var(--slideshow-button-padding-vertical, 19px) var(--slideshow-button-padding-horizontal, 28px) !important;
      border-radius: 9999px !important;
      font-size: var(--slideshow-button-font-size, 16px) !important;
      line-height: var(--slideshow-button-font-size, 16px) !important;
      font-weight: 500;
      backdrop-filter: blur(0.208333vw) !important;
      -webkit-backdrop-filter: blur(0.208333vw) !important;
      margin-top: 1.25vw !important;
    }

    .slideshow__slide .button-overflow-container{
      margin-top:0 !important;
    }

    .template-index .section-slideshow:first-of-type .content-size-large .slideshow__slide-content {
      max-width:65.625vw !important;
    }

    .template-index .section-slideshow:first-of-type .slideshow__slide-inner{
      padding: 0 var(--slideshow-desktop-content-left-spacing, 48px) var(--slideshow-desktop-content-bottom-spacing, 91px);
    }
}
</style>
{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "settings": [
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "options": [
        {
          "value": "desktop-height-image",
          "label": "Adapt to image"
        },
        {
          "value": "desktop-height-auto",
          "label": "Adapt to content"
        },
        {
          "value": "desktop-height-450",
          "label": "450px"
        },
        {
          "value": "desktop-height-550",
          "label": "550px"
        },
        {
          "value": "desktop-height-650",
          "label": "650px"
        },
        {
          "value": "desktop-height-750",
          "label": "750px"
        },
        {
          "value": "desktop-height-custom",
          "label": "Custom"
        },
        {
          "value": "desktop-height-full",
          "label": "Full screen"
        }
      ],
      "default": "desktop-height-650",
      "info": "Select Custom to use the custom height slider below."
    },
    {
      "type": "range",
      "id": "desktop_custom_height",
      "min": 320,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Desktop custom height",
      "info": "Only applies when Desktop height is set to Custom.",
      "default": 650
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "mobile-height-image",
          "label": "Adapt to image"
        },
        {
          "value": "mobile-height-auto",
          "label": "Adapt to content"
        },
        {
          "value": "mobile-height-400",
          "label": "400px"
        },
        {
          "value": "mobile-height-450",
          "label": "450px"
        },
        {
          "value": "mobile-height-500",
          "label": "500px"
        },
        {
          "value": "mobile-height-custom",
          "label": "Custom"
