{{- 'cust-collection-banner.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign desktop_ratio_width = section.settings.desktop_ratio_width | default: 1440
  assign desktop_ratio_height = section.settings.desktop_ratio_height | default: 280
  assign mobile_ratio_width = section.settings.mobile_ratio_width | default: 390
  assign mobile_ratio_height = section.settings.mobile_ratio_height | default: 280
  assign top_spacing = section.settings.top_spacing | default: 56
  assign bottom_spacing = section.settings.bottom_spacing | default: 0
  assign heading_font_size = section.settings.heading_font_size | default: 64
  assign description_font_size = section.settings.description_font_size | default: 18
  assign mobile_heading_font_size = section.settings.mobile_heading_font_size | default: 24
  assign mobile_description_font_size = section.settings.mobile_description_font_size | default: 12
  assign image_padding = section.settings.image_padding | default: 0

  if desktop_ratio_width == blank or desktop_ratio_width == 0
    assign desktop_ratio_width = 1440
  endif

  if desktop_ratio_height == blank or desktop_ratio_height == 0
    assign desktop_ratio_height = 280
  endif

  if mobile_ratio_width == blank or mobile_ratio_width == 0
    assign mobile_ratio_width = desktop_ratio_width
  endif

  if mobile_ratio_height == blank or mobile_ratio_height == 0
    assign mobile_ratio_height = desktop_ratio_height
  endif
-%}

<section
  class="cust-collection-banner"
  style="--cust-collection-banner-desktop-ratio: {{ desktop_ratio_width }} / {{ desktop_ratio_height }}; --cust-collection-banner-mobile-ratio: {{ mobile_ratio_width }} / {{ mobile_ratio_height }}; --cust-collection-banner-bg: {{ section.settings.background_color }}; --cust-collection-banner-text: {{ section.settings.text_color }}; --cust-collection-banner-top-spacing: {{ top_spacing }}px; --cust-collection-banner-bottom-spacing: {{ bottom_spacing }}px; --cust-collection-banner-heading-size: {{ heading_font_size }}px; --cust-collection-banner-description-size: {{ description_font_size }}px; --cust-collection-banner-mobile-heading-size: {{ mobile_heading_font_size }}px; --cust-collection-banner-mobile-description-size: {{ mobile_description_font_size }}px; --cust-collection-banner-image-padding: {{ image_padding }}px;"
>
  {%- render 'breadcrumbs' -%}

  <div class="cust-collection-banner__header">
    <div class="cust-collection-banner__content">
      {%- if heading != blank -%}
        <h2 class="cust-collection-banner__heading">{{ heading }}</h2>
      {%- endif -%}

      {%- if description != blank -%}
        <div class="cust-collection-banner__description rte">
          {{ description }}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if image -%}
    <div class="cust-collection-banner__media cust-collection-banner__media--desktop">
      {%- render 'responsive-image',
        image: image,
        sizes: '750x0,1440x0,2160x0,2880x0',
        class: 'cust-collection-banner__image cust-collection-banner__image--desktop',
        priority: 'high'
      -%}
    </div>
  {%- endif -%}

  {%- if image_mobile -%}
    <div class="cust-collection-banner__media cust-collection-banner__media--mobile">
      {%- render 'responsive-image',
        image: image_mobile,
        sizes: '390x0,750x0,1125x0',
        class: 'cust-collection-banner__image cust-collection-banner__image--mobile',
        priority: 'high'
      -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cust Collection banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers? glad you asked."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Top picks voted by our most loyal customers: kids who are obsessed with movement</p>"
    },
    {
      "type": "header",
      "content": "Font size"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 14,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "PC Heading font size",
      "default": 64
    },
    {
      "type": "range",
      "id": "description_font_size",
      "min": 14,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "PC Description font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_heading_font_size",
      "min": 12,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "Mobile Heading font size",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_description_font_size",
      "min": 12,
      "max": 70,
      "step": 1,
      "unit": "px",
      "label": "Mobile Description font size",
      "default": 12
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Image ratio"
    },
    {
      "type": "number",
      "id": "desktop_ratio_width",
      "label": "Desktop image width",
      "default": 1440,
      "info": "Only used to calculate the image ratio. The rendered image is full width."
    },
    {
      "type": "number",
      "id": "desktop_ratio_height",
      "label": "Desktop image height",
      "default": 280,
      "info": "Only used to calculate the image ratio. The rendered image height follows the width proportionally."
    },
    {
      "type": "number",
      "id": "mobile_ratio_width",
      "label": "Mobile image width",
      "default": 390,
      "info": "Only used to calculate the mobile image ratio."
    },
    {
      "type": "number",
      "id": "mobile_ratio_height",
      "label": "Mobile image height",
      "default": 280,
      "info": "Only used to calculate the mobile image ratio."
    },
    {
      "type": "header",
      "content": "Image padding"
    },
    {
      "type": "range",
      "id": "image_padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "PC image padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#140F0F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "number",
      "id": "top_spacing",
      "label": "Top spacing",
      "default": 56,
      "info": "Unit: px."
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Cust Collection banner"
    }
  ]
}
{% endschema %}
