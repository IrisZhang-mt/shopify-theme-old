    function calculateDistances() {
      stores.forEach(store => {
        store.distance = calculateDistance(
          userLocation.lat,
          userLocation.lng,
          store.lat,
          store.lng
        );
      });

      stores.sort((a, b) => a.distance - b.distance);
    }

    function calculateDistance(lat1, lon1, lat2, lon2) {
      const R = 3959;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a =
        Math.sin(dLat/2) * Math.sin(dLat/2) +
        Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
        Math.sin(dLon/2) * Math.sin(dLon/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return R * c;
    }

    function toRad(deg) {
      return deg * (Math.PI/180);
    }

    function updateStoresCount() {
      const nearbyStores = stores.filter(store => store.distance <= 50).length;
      const countText = `${nearbyStores} stores near your location, within 50 miles.`;
      const mapCount = document.getElementById('storesCount');
      const listCount = document.getElementById('listStoresCount');

      if (mapCount) mapCount.textContent = countText;
      if (listCount) listCount.textContent = countText;
    }

    function toggleView(view) {
      currentView = view;
      const section = document.querySelector('.find-stores-page');

      if (section) {
        section.classList.toggle('is-map-view', view === 'map');
        section.classList.toggle('is-list-view', view === 'list');
      }

      document.querySelectorAll('.view-toggle button').forEach(btn => {
        btn.classList.remove('active');
      });
      document.querySelector(`.toggle-${view}`).classList.add('active');

      document.getElementById('mapView').classList.toggle('active', view === 'map');
      document.getElementById('listView').classList.toggle('active', view === 'list');

      if (view === 'map') {
        displayMapView();
        setTimeout(() => {
          google.maps.event.trigger(map, 'resize');
          map.setCenter(userLocation);
        }, 100);
      } else {
        displayListView();
        document.getElementById('listStoresCount').textContent = document.getElementById('storesCount').textContent;
      }
    }

    function displayMapView() {
      markers.forEach(marker => marker.setMap(null));
      markers = [];

      const sidebar = document.getElementById('storeListSidebar');
      sidebar.innerHTML = '';

      stores.forEach((store, index) => {
        const storeItem = document.createElement('div');
        storeItem.className = 'store-item';

        let contactInfo = '';
        if (store.phone && store.phone.trim() !== '') {
          contactInfo += `<div><strong>Contact Number:</strong> ${store.phone}</div>`;
        }
        if (store.hours && store.hours.trim() !== '') {
          contactInfo += `<div><strong>Operation Hour:</strong> ${store.hours}</div>`;
        }

        let emailInfo = '';
        if (store.email && store.email.trim() !== '') {
          emailInfo = `<div class="store-email"><strong>Email:</strong> ${store.email}</div>`;
        }

        storeItem.innerHTML = `
          <div class="store-name">${store.name}</div>
          <div class="store-address">${store.address}</div>
          ${contactInfo ? `<div class="store-contact">${contactInfo}</div>` : ''}
          ${emailInfo}
          <div class="store-distance">
            <svg class="location-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            ${store.distance.toFixed(1)} miles from your location
          </div>
          <a href="https://www.google.com/maps/dir/?api=1&origin=${userLocation.lat},${userLocation.lng}&destination=${store.lat},${store.lng}"
            target="_blank" class="directions-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"></path>
              <path d="M8 2v16"></path>
              <path d="M16 6v16"></path>
            </svg>
            Get Directions
          </a>
        `;

        storeItem.onclick = () => selectStore(index,false);
        sidebar.appendChild(storeItem);

        const marker = new google.maps.Marker({
          position: { lat: store.lat, lng: store.lng },
          map: map,
          title: store.name,
          icon: {
            url: 'https://maps.google.com/mapfiles/ms/icons/orange-dot.png'
          }
        });

        const infoWindow = new google.maps.InfoWindow({
          content: createInfoWindowContent(store)
        });

        marker.addListener('click', () => {
          if (activeInfoWindow) {
            activeInfoWindow.close();
          }
          infoWindow.open(map, marker);
          activeInfoWindow = infoWindow;
          selectStore(index,true);
        });

        markers.push(marker);
      });

      updateMap();
    }

    function createInfoWindowContent(store) {
      return `
        <div class="store-info-window">
          <img src="${store.image}" alt="${store.name}" onerror="handleImageError(this, '${store.name}')">
          <h3><strong>${store.name}</strong></h3>
          <p>${store.address}</p>
          ${store.phone ? `<p><strong>Phone:</strong> ${store.phone}</p>` : ''}
          ${store.hours ? `<p><strong>Hours:</strong> ${store.hours}</p>` : ''}
          ${store.email ? `<p><strong>Email:</strong> ${store.email}</p>` : ''}
          <a href="https://www.google.com/maps/dir/?api=1&origin=${userLocation.lat},${userLocation.lng}&destination=${store.lat},${store.lng}"
             target="_blank" class="directions-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"></path>
              <path d="M8 2v16"></path>
              <path d="M16 6v16"></path>
            </svg>
            Get Directions
          </a>
        </div>
      `;
    }

    function selectStore(index, fromMarker = false) {
      document.querySelectorAll('.store-item').forEach((item, i) => {
        item.classList.toggle('active', i === index);
      });

      if (!fromMarker && markers[index]) {
        if (activeInfoWindow) {
          activeInfoWindow.close();
        }

        const store = stores[index];
        const infoWindow = new google.maps.InfoWindow({
          content: createInfoWindowContent(store)
        });
        infoWindow.open(map, markers[index]);
        activeInfoWindow = infoWindow;
      }

      const store = stores[index];
      map.setCenter({ lat: store.lat, lng: store.lng });
      map.setZoom(15);
    }

    function displayListView() {
      const grid = document.getElementById('storeGrid');
      grid.innerHTML = '';

      const filteredStores = currentFilter === 'all'
        ? stores
        : stores.filter(store => {
            const city = (store.city || '').toLowerCase();
            const province = (store.province || '').toLowerCase();
            const name = (store.name || '').toLowerCase();
            const address = (store.address || '').toLowerCase();

            switch(currentFilter) {
              case 'hongkong':
                return city.includes('hong kong') ||
                       province.includes('hong kong') ||
                       name.includes('hong kong') ||
                       address.includes('hong kong');

              case 'macau':
                return city.includes('macau') ||
                       province.includes('macau') ||
                       name.includes('macau') ||
                       address.includes('macau');

              case 'malaysia':
                return city.includes('kuala lumpur') ||
                       city.includes('malaysia') ||
                       province.includes('malaysia') ||
                       name.includes('malaysia') ||
                       address.includes('malaysia') ||
                       address.includes('kuala lumpur');

              case 'singapore':
                return city.includes('singapore') ||
                       province.includes('singapore') ||
                       name.includes('singapore') ||
                       address.includes('singapore');

              case 'usa':
                return city.includes('usa') ||
                       city.includes('united states') ||
                       province.includes('usa') ||
                       province.includes('united states') ||
                       name.includes('usa') ||
                       name.includes('united states') ||
                       address.includes('usa') ||
                       address.includes('united states');

              case 'uae':
                return city.includes('dubai') ||
                       city.includes('uae') ||
                       city.includes('emirates') ||
                       city.includes('abu dhabi') ||
                       province.includes('uae') ||
                       province.includes('emirates') ||
                       name.includes('uae') ||
                       name.includes('emirates') ||
                       name.includes('dubai') ||
                       address.includes('uae') ||
                       address.includes('emirates') ||
                       address.includes('dubai');

              default:
                return city.includes(currentFilter) || province.includes(currentFilter);
            }
          });

      filteredStores.forEach(store => {
        const card = document.createElement('div');
        card.className = 'store-card';

        let contactInfo = '';
        if (store.phone && store.phone.trim() !== '') {
          contactInfo += `<div>Contact Number: ${store.phone}</div>`;
        }
        if (store.hours && store.hours.trim() !== '') {
          contactInfo += `<div>Operation Hour: ${store.hours}</div>`;
        }

        card.innerHTML = `
          <img src="${store.image}" alt="${store.name}" class="store-card-image" onerror="handleImageError(this, '${store.name}')">
          <div class="store-card-content">
            <div class="store-card-title">${store.name}</div>
            <div class="store-card-info">${store.address}</div>
            ${contactInfo ? `<div class="store-card-contact">${contactInfo}</div>` : ''}
            ${store.email && store.email.trim() !== '' ? `<div class="store-card-email">Email: ${store.email}</div>` : ''}
            <div class="store-card-distance">
              <svg class="location-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              ${store.distance.toFixed(1)} miles from your location
            </div>
            <a href="https://www.google.com/maps/dir/?api=1&origin=${userLocation.lat},${userLocation.lng}&destination=${store.lat},${store.lng}"
               target="_blank" class="directions-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"></path>
                <path d="M8 2v16"></path>
                <path d="M16 6v16"></path>
              </svg>
              Get Directions
            </a>
            <svg class="badge-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function filterStores(filter) {
      currentFilter = filter;

      document.querySelectorAll('.filter-button').forEach(btn => {
        btn.classList.remove('active');
      });
      event.target.classList.add('active');

      displayListView();
    }

    function searchLocation() {
      const searchInput = document.getElementById('locationSearch').value;

      if (!searchInput) return;

      const geocoder = new google.maps.Geocoder();

      geocoder.geocode({ address: searchInput }, (results, status) => {
        if (status === 'OK' && results[0]) {
          const location = results[0].geometry.location;
          userLocation = {
            lat: location.lat(),
            lng: location.lng()
          };

          calculateDistances();
          updateStoresCount();

          {% comment %} if (currentView === 'map') {
            displayMapView();
            map.setCenter(userLocation);
          } else {
            displayListView();
          } {% endcomment %}

          displayMapView();

          // 直接设置地图中心和缩放，而不是调用 updateMap()
          map.setCenter(userLocation);
          map.setZoom(12);

          // 更新用户位置标记
          if (userMarker) {
            userMarker.setPosition(userLocation);
          }
        } else {
          alert('Location not found. Please try a different search.');
        }
      });
    }

    function updateMap() {
      if (!map || stores.length === 0) return;

      const bounds = new google.maps.LatLngBounds();
      bounds.extend(userLocation);

      stores.forEach(store => {
        bounds.extend({ lat: store.lat, lng: store.lng });
      });

      map.fitBounds(bounds);

      map.setCenter(userLocation);
      map.setZoom(2);

      const listener = google.maps.event.addListener(map, 'idle', function() {
        if (map.getZoom() > 15) map.setZoom(15);
        if (map.getZoom() < 2) map.setZoom(2);

        google.maps.event.removeListener(listener);
      });
    }
  </script>


