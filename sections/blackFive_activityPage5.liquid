<style>
  #shopify-section-{{section.id}} .blackFive_activityPage5All{
      margin-top: {{section.settings.Desktop_top}}px;
      margin-bottom: {{section.settings.Desktop_bottom}}px;

      padding-top:{{section.settings.Desktop_paddingTop}}px;
      padding-bottom:{{section.settings.Desktop_paddingBottom}}px;
  }
  @media(max-width:999px) {
      #shopify-section-{{section.id}} .blackFive_activityPage5All{
          margin-top: {{section.settings.Mobile_top}}px;
          margin-bottom: {{section.settings.Mobile_bottom}}px;

          padding-top:{{section.settings.Mobile_paddingTop}}px;
          padding-bottom:{{section.settings.Mobile_paddingBottom}}px;
      }
  }

  #shopify-section-{{section.id}} .blackFive_activityPage5_itemText {
    line-height: 29px;
    color: {{section.settings.text_color}};
  }
  .blackFive_activityPage5_itemText p:last-child {
      margin: 0;
  }
  .blackFive_activityPage5_item img {
    object-fit: cover;
    width: 100%;
  }
  .blackFive_activityPage5_item {
    text-decoration: unset !important;
  }
  .blackFive_activityPage5_bottomLeftTitle,.blackFive_activityPage5_bottomLeftTitle p ,.blackFive_activityPage5_bottomLeftText p:last-child{
    margin: 0;
  }
  #shopify-section-{{section.id}} .blackFive_activityPage5_title strong {
    font-weight: 600;
    color: {{section.settings.active_color}} !important;
  }
  #shopify-section-{{section.id}} .blackFive_activityPage5_bottom , #shopify-section-{{section.id}} .blackFive_activityPage5_bottomLeftTitle{
      background-color: {{section.settings.bottom_bg_color}};
      color: {{section.settings.bottom_color}};
  }
  .blackFive_activityPage5_bottomLeftTitle,.blackFive_activityPage5_title {
    line-height: 110%;
  }
  .blackFive_activityPage5All .container {
    padding: 0 15px;
  }
  .blackFive_activityPage5_title p {
    margin: 0;
  }
  @media (min-width: 1000px) {
    .blackFive_activityPage5_title {
      font-size: 34px;
      font-weight: 500;
    }

    .blackFive_activityPage5_title {
        text-align: center;
        margin-bottom: 40px;
    }
    .blackFive_activityPage5_box {
        display: grid;
        grid-template-columns: repeat(4, 1fr); /* 默认4列 */
      
    }
    .blackFive_activityPage5_item {
        display: flex;
        position: relative;
    }
    .blackFive_activityPage5_item:nth-child(5) {
        grid-column: 1 / span 2; 
    }
    .blackFive_activityPage5_item:nth-child(6) {
        grid-column: 3 / span 2;
    }
    .blackFive_activityPage5_itemPosition {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 23px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }
    .blackFive_activityPage5_itemText {
      font-size: 26px;
    }
    .blackFive_activityPage5_itemPosition svg {
      width: 60px;
      height: auto;
    }
    .blackFive_activityPage5_bottom {
      padding: 80px 0;
    }
    .blackFive_activityPage5_bottomBox {
        display: flex;
        gap: 40px;
        justify-content: center;
        align-items: center;
    }
    .blackFive_activityPage5_bottomLeft {
        display: flex;
        flex-direction: column;
        text-align: right;
    }
    .blackFive_activityPage5_bottomLeftTitle {
      font-size: 34px;
      font-weight: 500;
    }
    .blackFive_activityPage5_bottomLeftText {
      font-size: 18px;
      margin-top: 10px;
      line-height: 29px;
    }
    .blackFive_activityPage5_bottomRight {
      display: flex;
    }
    .blackFive_activityPage5_bottomRight svg {
      width: 60px;
      height: auto;
    }
  
  }
  @media (max-width: 999px) {
    .blackFive_activityPage5_title {
      font-size: 21px;
      font-weight: 500;
      text-align: center;
      padding: 0 15px;
      margin-bottom: 32px;
    }
    .blackFive_activityPage5_title strong {
      display: block;
    }
    .blackFive_activityPage5_box {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* 默认4列 */
      
    }
    .blackFive_activityPage5_item {
        display: flex;
        position: relative;
    }
    .blackFive_activityPage5_item:nth-child(5),
    .blackFive_activityPage5_item:nth-child(6) {
      grid-column: 1 / span 2; /* 各占整行 */
    }
    .blackFive_activityPage5_itemPosition {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 12px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }
    .blackFive_activityPage5_itemText {
      font-size: 18px;
    }
    .blackFive_activityPage5_itemPosition svg {
      width: 40px;
      height: auto;
    }
    .blackFive_activityPage5_bottom {
      padding: 65px 0;
    }
    .blackFive_activityPage5_bottomBox {
        display: flex;
        gap: 10px;
        justify-content: center;
        align-items: center;
    }
    .blackFive_activityPage5_bottomLeft {
        display: flex;
        flex-direction: column;
        text-align: right;
    }
    .blackFive_activityPage5_bottomLeftTitle {
      font-size: 21px;
      font-weight: 500;
    }
    .blackFive_activityPage5_bottomLeftText {
      font-size: 12px;
      margin-top: 5px;
    }
    .blackFive_activityPage5_bottomRight {
      display: flex;
    }
    .blackFive_activityPage5_bottomRight svg {
      width: 40px;
      height: auto;
    }
    .blackFive_activityPage5All .row,.blackFive_activityPage5All .columns {
      padding: 0;
    }

  }
</style>
<div class="blackFive_activityPage5All">
  <div class="row full-width-row">
    <div class="columns">
      {% if section.settings.title != blank %}
      <h2 class="blackFive_activityPage5_title">
          {{ section.settings.title }}
      </h2>
      {% endif %}
      <div class="blackFive_activityPage5_box">
        {% for block in section.blocks %}
          <a href="{{block.settings.link}}" class="blackFive_activityPage5_item">
            {% if block.settings.img != blank %}
              <img src="{{ block.settings.img | img_url:'master' }}" alt="{{ block.settings.img.alt }}">
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="blackFive_activityPage5_itemPosition">
                <div class="blackFive_activityPage5_itemText">
                  {{ block.settings.text }}
                </div>

                
                  <svg id="ctr" xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80">
                    <defs>
                      <style>
                        .cls-1 {
                          fill: #fff;
                        }

                        .cls-2 {
                          fill: #151515;
                          fill-rule: evenodd;
                        }
                      </style>
                    </defs>
                    <circle id="椭圆_3" data-name="椭圆 3" class="cls-1" cx="40" cy="40" r="40"/>
                    <path id="矩形_17" data-name="矩形 17" class="cls-2" d="M1362.8,4511.37l22.63,22.63-2.27,2.26-22.62-22.62Z" transform="translate(-1330 -4494)"/>
                    <path id="矩形_17_拷贝" data-name="矩形 17 拷贝" class="cls-2" d="M1360.54,4554.36l22.62-22.62,2.27,2.26-22.63,22.63Z" transform="translate(-1330 -4494)"/>
                  </svg>

              </div>
            {% endif %}
          </a>
        {% endfor %}
      </div>
      {% if section.settings.bottom_title == blank and section.settings.bottom_text == blank %}
          {%- else -%}
          <div class="blackFive_activityPage5_bottom">
              <div class="container">
                  <div class="">
                    <div class="blackFive_activityPage5_bottomBox">
                        <div class="blackFive_activityPage5_bottomLeft">
                            {% if section.settings.bottom_title != blank %}
                            <h2 class="blackFive_activityPage5_bottomLeftTitle">
                                {{ section.settings.bottom_title }}
                            </h2>
                            {% endif %}
                            {% if section.settings.bottom_text != blank %}
                            <div class="blackFive_activityPage5_bottomLeftText">
                                {{ section.settings.bottom_text }}
                            </div>
                            {% endif %}
                        </div>
                        <a href="{{ section.settings.bottom_link }}" class="blackFive_activityPage5_bottomRight">
                            
                          <svg id="ctr" xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80">
                            <defs>
                              <style>
                                .cls-1 {
                                  fill: #fff;
                                }

                                .cls-2 {
                                  fill: #151515;
                                  fill-rule: evenodd;
                                }
                              </style>
                            </defs>
                            <circle id="椭圆_3" data-name="椭圆 3" class="cls-1" cx="40" cy="40" r="40"/>
                            <path id="矩形_17" data-name="矩形 17" class="cls-2" d="M1362.8,4511.37l22.63,22.63-2.27,2.26-22.62-22.62Z" transform="translate(-1330 -4494)"/>
                            <path id="矩形_17_拷贝" data-name="矩形 17 拷贝" class="cls-2" d="M1360.54,4554.36l22.62-22.62,2.27,2.26-22.63,22.63Z" transform="translate(-1330 -4494)"/>
                          </svg>

                        </a>
                    </div>
                 </div>
              </div>
          </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Black Five Activity Page5",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
        "type": "richtext",
        "id": "title",
        "label": "title"
    },
    {
        "type": "textarea",
        "id": "bottom_title",
        "label": "bottom title"
    },
    {
        "type": "richtext",
        "id": "bottom_text",
        "label": "bottom text"
    },
    {
        "type": "url",
        "id": "bottom_link",
        "label": "bottom link"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "active color"   
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "text color"
    },
     {
      "type": "color",
      "id": "bottom_bg_color",
      "label": "bottom background color"
    },
    {
      "type": "color",
      "id": "bottom_color",
      "label": "bottom color"
    },
    {
      "type": "header",
      "content": "Spacing Top:"
    },
    {
      "type": "number",
      "id": "Desktop_top",
      "label": "Desktop Margin Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_top",
      "label": "Mobile Margin Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "Desktop_paddingTop",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_paddingTop",
      "label": "Mobile Padding Top",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing Bottom:"
    },
    {
      "type": "number",
      "id": "Desktop_bottom",
      "label": "Desktop Margin Bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_bottom",
      "label": "Mobile Margin Bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "Desktop_paddingBottom",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "number",
      "id": "Mobile_paddingBottom",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "img"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Black Five Activity Page5"
    }
  ]
}
{% endschema %}
